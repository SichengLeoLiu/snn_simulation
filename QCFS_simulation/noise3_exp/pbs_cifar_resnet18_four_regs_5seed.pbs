#!/bin/bash
#PBS -N r18four
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR ResNet-18 4 methods x 5 seeds. One job = one dataset/method/seed.
# METHOD: l2all | l2wo | mne | onesided
# DATASET: cifar10 | cifar100
# SEED: 40–44
# Logs/results on scratch. Do not tee to $HOME.
#
#   cd /home/595/sl9144/codes/snn_simulation && git pull
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   for DS in cifar10 cifar100; do
#     for M in l2all l2wo mne onesided; do
#       for S in 40 41 42 43 44; do
#         qsub -N "r18_${DS}_${M}_${S}" \
#           -v CIFAR_ROOT,DATASET=${DS},METHOD=${M},SEED=${S},OUT_DIR=/scratch/gs14/sl9144/snn_results/cifar_resnet18_four_regs_5seed \
#           QCFS_simulation/noise3_exp/pbs_cifar_resnet18_four_regs_5seed.pbs
#       done
#     done
#   done

set -euo pipefail

METHOD="${METHOD:?set METHOD=l2all|l2wo|mne|onesided}"
DATASET="${DATASET:-cifar10}"
SEED="${SEED:-42}"

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/r18four_${DATASET}_${METHOD}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1
echo "LIVE_LOG=${LIVE_LOG}"
echo "DATASET=${DATASET} METHOD=${METHOD} SEED=${SEED} TEST_ONLY=${TEST_ONLY:-0}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_resnet18_four_regs_5seed}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "CIFAR_ROOT=${CIFAR_ROOT}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

ARGS=(
  --dataset "${DATASET}"
  --seed "${SEED}"
  --method "${METHOD}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi

python -u noise3_exp/run_cifar_resnet18_four_regs_5seed.py "${ARGS[@]}"

echo "=== ALL DONE $(date) DATASET=${DATASET} METHOD=${METHOD} SEED=${SEED} ==="
ls -la "${OUT_DIR}/${DATASET}/r18_${METHOD}/seed${SEED}" || ls -la "${OUT_DIR}"
