#!/bin/bash
#PBS -N v16mnea
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR VGG-16 seed-42 Old MNE-L2 block-role ablation.
# VARIANT: all | early | late | no_late | no_early | late_only | early_only
# DATASET: cifar10 | cifar100
# Do not retune alpha/tau. Same rc=1e-4, detach lambda.
#
#   cd /home/595/sl9144/codes/snn_simulation && git fetch origin && git reset --hard origin/main
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   for DS in cifar10 cifar100; do
#     for V in all early late no_late no_early late_only early_only; do
#       qsub -N "v16mnea_${DS}_${V}" \
#         -v CIFAR_ROOT,DATASET=${DS},VARIANT=${V},SEED=42,OUT_DIR=/scratch/gs14/sl9144/snn_results/cifar_vgg16_mne_role_ablation_seed42,CKPT_ROOT=/home/595/sl9144/codes/snn_simulation/QCFS_simulation \
#         QCFS_simulation/noise3_exp/pbs_cifar_vgg16_mne_role_ablation_seed42.pbs
#     done
#   done

set -euo pipefail

VARIANT="${VARIANT:?set VARIANT}"
DATASET="${DATASET:-cifar10}"
SEED="${SEED:-42}"

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/v16mnea_${DATASET}_${VARIANT}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1
echo "LIVE_LOG=${LIVE_LOG}"
echo "DATASET=${DATASET} VARIANT=${VARIANT} SEED=${SEED}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_vgg16_mne_role_ablation_seed42}"
CKPT_ROOT="${CKPT_ROOT:-/home/595/sl9144/codes/snn_simulation/QCFS_simulation}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "CKPT_ROOT=${CKPT_ROOT}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

ARGS=(
  --dataset "${DATASET}"
  --seed "${SEED}"
  --variant "${VARIANT}"
  --out-root "${OUT_DIR}"
  --ckpt-root "${CKPT_ROOT}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi

python -u noise3_exp/run_cifar_vgg16_mne_role_ablation_seed42.py "${ARGS[@]}"

echo "=== ALL DONE $(date) DATASET=${DATASET} VARIANT=${VARIANT} SEED=${SEED} ==="
ls -la "${OUT_DIR}/${DATASET}/mneabl_${VARIANT}" || ls -la "${OUT_DIR}"
