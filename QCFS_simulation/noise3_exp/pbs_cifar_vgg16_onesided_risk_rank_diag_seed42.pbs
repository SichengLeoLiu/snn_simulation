#!/bin/bash
#PBS -N vgg_rrank
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=12:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# VGG-16 One-sided risk-ranking diagnostic. Freeze ckpts. Do not retrain.
# METHOD: onesided | mne | l2wo
# DATASET: cifar10 | cifar100
# Observational only: r / r||W||^2 / q vs A, P_cross, D. sigma=0.25,0.5,1.0
#
#   cd /home/595/sl9144/codes/snn_simulation && git fetch origin && git reset --hard origin/main
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   for DS in cifar10 cifar100; do
#     for M in onesided mne l2wo; do
#       qsub -N "rrank_${DS}_${M}" \
#         -v CIFAR_ROOT,DATASET=${DS},METHOD=${M},SEED=42,OUT_DIR=/scratch/gs14/sl9144/snn_results/cifar_vgg16_onesided_risk_rank_seed42 \
#         QCFS_simulation/noise3_exp/pbs_cifar_vgg16_onesided_risk_rank_diag_seed42.pbs
#     done
#   done

set -euo pipefail

METHOD="${METHOD:?set METHOD=onesided|mne|l2wo}"
DATASET="${DATASET:-cifar10}"
SEED="${SEED:-42}"

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/vgg_rrank_${DATASET}_${METHOD}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1
echo "LIVE_LOG=${LIVE_LOG}"
echo "DATASET=${DATASET} METHOD=${METHOD} SEED=${SEED}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-64}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_vgg16_onesided_risk_rank_seed42}"
ONESIDED_ROOT="${ONESIDED_ROOT:-/scratch/gs14/sl9144/snn_results/cifar_vgg16_onesided_q_assignment_ablation_seed${SEED}}"
COMP_ROOT="${COMP_ROOT:-/scratch/gs14/sl9144/snn_results/cifar_vgg16_mne_component_ablation_seed${SEED}}"
CKPT_ROOT="${CKPT_ROOT:-/home/595/sl9144/codes/snn_simulation/QCFS_simulation}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

python -u noise3_exp/run_cifar_vgg16_onesided_risk_rank_diag_seed42.py \
  --dataset "${DATASET}" \
  --method "${METHOD}" \
  --seed "${SEED}" \
  --n-images "${N_IMAGES:-2000}" \
  --n-noise "${N_NOISE:-5}" \
  --sigmas "${SIGMAS:-0.25,0.5,1.0}" \
  --batch-size "${CIFAR_BATCH}" \
  --workers "${CIFAR_NUM_WORKERS}" \
  --onesided-root "${ONESIDED_ROOT}" \
  --comp-root "${COMP_ROOT}" \
  --ckpt-root "${CKPT_ROOT}" \
  --out-root "${OUT_DIR}"

echo "=== ALL DONE $(date) DATASET=${DATASET} METHOD=${METHOD} SEED=${SEED} ==="
ls -la "${OUT_DIR}/${DATASET}/${METHOD}" || ls -la "${OUT_DIR}"
