#!/bin/bash
#PBS -N r18ndbd
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=36:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# ResNet-18 same-map gate: no-detach MNE-L2, resnet map, NO unmatched-head L2.
# DATASET: cifar10 | cifar100
# SEED: 42
#
# This is the missing body for attributing head L2. Compare against
#   /scratch/gs14/sl9144/snn_results/cifar_mne_nodetach_unmatched_head_l2_seed42
#     /{dataset}/resnet18_mne_head/seed42
# Four-regs r18_nodetach is legacy-map and must not be used as this control.
# η_MNE=1e-4. Do not retune from test. EVAL_SEED=0.
#
#   cd /home/595/sl9144/codes/snn_simulation
#   git fetch origin codex/task-cov-mne-resnet18
#   git checkout origin/codex/task-cov-mne-resnet18 -- \
#     QCFS_simulation/noise3_exp/run_cifar_mne_unmatched_head_l2_seed42.py \
#     QCFS_simulation/noise3_exp/pbs_cifar_resnet18_nodetach_resnetmap_seed42.pbs
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   OUT=/scratch/gs14/sl9144/snn_results/cifar_resnet18_nodetach_resnetmap_seed42
#   PBS=QCFS_simulation/noise3_exp/pbs_cifar_resnet18_nodetach_resnetmap_seed42.pbs
#
#   for DS in cifar10 cifar100; do
#     TAG=${DS#cifar}
#     qsub -l walltime=36:00:00 -N "rmap${TAG}" \
#       -v CIFAR_ROOT,DATASET=${DS},SEED=42,EVAL_SEED=0,OUT_DIR=${OUT} \
#       ${PBS}
#   done

set -euo pipefail

ARCH="resnet18"
DATASET="${DATASET:?set DATASET=cifar10|cifar100}"
METHOD="mne_body"
SEED="${SEED:-42}"
EVAL_SEED="${EVAL_SEED:-0}"
N_STREAMS="${N_STREAMS:-8}"
DIAG_SIGMAS="${DIAG_SIGMAS:-1,3,5}"
BODY="nodetach"
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac
if [[ "${SEED}" != "42" ]]; then
  echo "ERROR: this gate is seed 42 only (got SEED=${SEED})"
  exit 2
fi

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/r18ndbd_${DATASET}_${METHOD}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export N_STREAMS
export DIAG_SIGMAS

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_resnet18_nodetach_resnetmap_seed42}"
mkdir -p "${OUT_DIR}"
echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) ARCH=${ARCH} DATASET=${DATASET} METHOD=${METHOD} BODY=${BODY} SEED=${SEED} EVAL_SEED=${EVAL_SEED}"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR} TEST_ONLY=${TEST_ONLY:-0} RETRAIN=${RETRAIN:-0}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"
echo "NOTE: regularizer=mne_l2 layer_map=resnet no unmatched-head L2"

if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

HYBRID="/scratch/gs14/sl9144/snn_results/cifar_mne_nodetach_unmatched_head_l2_seed42/${DATASET}/resnet18_mne_head/seed42"
if [[ -e "${HYBRID}" ]]; then
  echo "hybrid counterpart present: ${HYBRID}"
else
  echo "WARN: hybrid counterpart missing: ${HYBRID}"
fi

ARGS=(
  --arch "${ARCH}"
  --dataset "${DATASET}"
  --method "${METHOD}"
  --body "${BODY}"
  --seed "${SEED}"
  --eval-seed "${EVAL_SEED}"
  --n-streams "${N_STREAMS}"
  --sigmas "${DIAG_SIGMAS}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi
if [[ "${SKIP_DIAG:-0}" == "1" ]]; then
  ARGS+=(--skip-diag)
fi

python -u noise3_exp/run_cifar_mne_unmatched_head_l2_seed42.py "${ARGS[@]}"
echo "DONE $(date)"
