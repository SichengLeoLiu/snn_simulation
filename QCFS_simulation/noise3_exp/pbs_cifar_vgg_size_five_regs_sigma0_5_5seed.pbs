#!/bin/bash
#PBS -N cifvgg
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR-10/100 VGG11/13/19 五方法：训练 T=0 + 测试 T=16 post-IF σ=0…5
#   每个 job 一个 DATASET × ARCH × METHOD，seeds 40–44
#   METHOD=weight_decay | weight_decay_weights_only | l1 | old_detach | calibrated_mne_a0p1
#
# Login:
#   cd /home/595/sl9144/codes/snn_simulation && git pull
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   for ds in cifar10 cifar100; do
#     for arch in vgg11 vgg13 vgg19; do
#       for m in weight_decay weight_decay_weights_only l1 old_detach calibrated_mne_a0p1; do
#         qsub -v CIFAR_ROOT,DATASET=$ds,ARCH=$arch,METHOD=$m \
#           QCFS_simulation/noise3_exp/pbs_cifar_vgg_size_five_regs_sigma0_5_5seed.pbs
#       done
#     done
#   done

set -euo pipefail

DATASET="${DATASET:?set DATASET=cifar10 or cifar100}"
ARCH="${ARCH:?set ARCH=vgg11, vgg13, or vgg19}"
METHOD="${METHOD:?set METHOD, e.g. old_detach}"

mkdir -p /home/595/sl9144/logs
LIVE_LOG="/home/595/sl9144/logs/cifvgg_${DATASET}_${ARCH}_${METHOD}.${PBS_JOBID:-manual}.out"
exec > >(tee -a "${LIVE_LOG}") 2>&1
echo "LIVE_LOG=${LIVE_LOG}"
echo "DATASET=${DATASET} ARCH=${ARCH} METHOD=${METHOD}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-${ROOT}/../important_results/${DATASET}_${ARCH}_five_regs_sigma0_5_5seed}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "CIFAR_ROOT=${CIFAR_ROOT}"

if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

case "${METHOD}" in
  weight_decay|weight_decay_weights_only|l1)
    VARIANT_ARGS=(--variants --baselines "${METHOD}")
    ;;
  old_detach|calibrated_mne_a0p1)
    VARIANT_ARGS=(--variants "${METHOD}" --baselines)
    ;;
  *)
    echo "ERROR: unknown METHOD=${METHOD}"
    exit 1
    ;;
esac

python -u noise3_exp/run_mne_stability_ablation.py \
  --datasets "${DATASET}" \
  --arch "${ARCH}" \
  "${VARIANT_ARGS[@]}" \
  --rcs 1e-4 \
  --calibrated-mne-rcs 5e-4 \
  --seeds 40 41 42 43 44 \
  --batch-size "${CIFAR_BATCH}" \
  --workers "${CIFAR_NUM_WORKERS}" \
  --first-layer-noise-position post_input_if \
  --noise-sigma-start 0.0 \
  --noise-sigma-end 5.0 \
  --noise-sigma-step 0.25 \
  --out-root "${OUT_DIR}"

echo "=== ALL DONE $(date) DATASET=${DATASET} ARCH=${ARCH} METHOD=${METHOD} ==="
ls -la "${OUT_DIR}"/mne_stability_ablation_*.csv || true
