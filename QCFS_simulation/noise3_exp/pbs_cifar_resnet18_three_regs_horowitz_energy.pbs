#!/bin/bash
#PBS -N r18_e
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=01:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# ResNet-18 Horowitz energy for L2-all / L2-wo / L1-wo. Test only.
# ANN T=0 plus SNN T=4,8,16. Seeds 40-44. CIFAR-10 then CIFAR-100.
# Checkpoints are the same L=16 weights as the noise curves.
# Does not overwrite the TA-MNE-U energy CSV.

set -euo pipefail

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/r18_energy.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_resnet18_three_regs_horowitz_energy}"
mkdir -p "${OUT_DIR}"
echo "host=$(hostname) date=$(date) OUT_DIR=${OUT_DIR}"

python3 -u noise3_exp/measure_vgg16_horowitz_energy.py \
  --arch resnet18 \
  --datasets cifar10 cifar100 \
  --methods l2 l2_wo l1 \
  --seeds 40 41 42 43 44 \
  --time-steps 4 8 16 \
  --batch-size "${CIFAR_BATCH}" \
  --workers "${CIFAR_NUM_WORKERS}" \
  --max-samples 0 \
  --out-dir "${OUT_DIR}"

echo "DONE $(date)"
ls -la "${OUT_DIR}"
