#!/bin/bash
#PBS -N gamne
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR seed-42 Graph-Aware MNE-L2 screen. Do not retune alpha/tau.
# ARCH: vgg16 | resnet18
# VARIANT: onesided | onesided_norm | ga_nocov | ga_full
# DATASET: cifar10 | cifar100
#
#   cd /home/595/sl9144/codes/snn_simulation && git fetch origin && git reset --hard origin/main
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   for ARCH in vgg16 resnet18; do
#     for DS in cifar10 cifar100; do
#       for V in onesided onesided_norm ga_nocov ga_full; do
#         qsub -N "ga_${ARCH}_${DS}_${V}" \
#           -v CIFAR_ROOT,ARCH=${ARCH},DATASET=${DS},VARIANT=${V},SEED=42,OUT_DIR=/scratch/gs14/sl9144/snn_results/cifar_ga_mne_seed42 \
#           QCFS_simulation/noise3_exp/pbs_cifar_ga_mne_seed42.pbs
#       done
#     done
#   done

set -euo pipefail

ARCH="${ARCH:?set ARCH=vgg16 or resnet18}"
VARIANT="${VARIANT:?set VARIANT}"
DATASET="${DATASET:-cifar10}"
SEED="${SEED:-42}"

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/gamne_${ARCH}_${DATASET}_${VARIANT}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1
echo "LIVE_LOG=${LIVE_LOG}"
echo "ARCH=${ARCH} DATASET=${DATASET} VARIANT=${VARIANT} SEED=${SEED}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_ga_mne_seed42}"
MAPPING_ROOT="${MAPPING_ROOT:-/scratch/gs14/sl9144/snn_results/cifar_resnet18_mapping_diag_seed42}"
INTENSITY_ROOT="${INTENSITY_ROOT:-/scratch/gs14/sl9144/snn_results/cifar_resnet18_intensity_diag_seed42}"
VGG_QABL_ROOT="${VGG_QABL_ROOT:-/scratch/gs14/sl9144/snn_results/cifar_vgg16_onesided_q_assignment_ablation_seed42}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

ARGS=(
  --arch "${ARCH}"
  --dataset "${DATASET}"
  --seed "${SEED}"
  --variant "${VARIANT}"
  --out-root "${OUT_DIR}"
  --mapping-root "${MAPPING_ROOT}"
  --intensity-root "${INTENSITY_ROOT}"
  --vgg-qabl-root "${VGG_QABL_ROOT}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi

python -u noise3_exp/run_cifar_ga_mne_seed42.py "${ARGS[@]}"

echo "=== ALL DONE $(date) ARCH=${ARCH} DATASET=${DATASET} VARIANT=${VARIANT} SEED=${SEED} ==="
ls -la "${OUT_DIR}/${ARCH}/${DATASET}/gadiag_${ARCH}_${VARIANT}" || ls -la "${OUT_DIR}"
