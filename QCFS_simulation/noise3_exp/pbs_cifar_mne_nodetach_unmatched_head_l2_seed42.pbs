#!/bin/bash
#PBS -N mnendhd
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# Seed-42: no-detach MNE-L2 + unmatched classifier-head L2.
# ARCH: resnet18 | vgg16
# DATASET: cifar10 | cifar100
# METHOD: mne | mne_head
#
# mne is eval-only reuse of existing no-detach checkpoints.
# mne_head trains hybrid: no-detach MNE on IF body + L2 on the unmatched head.
# Do not submit l2wo (already in the detach screen). Do not submit mne_unmatched
# (same layer as mne_head on these models). Do not retune eta from test.
#
#   cd /home/595/sl9144/codes/snn_simulation
#   git fetch origin codex/task-cov-mne-resnet18
#   git checkout origin/codex/task-cov-mne-resnet18 -- \
#     QCFS_simulation/noise3_exp/run_cifar_mne_unmatched_head_l2_seed42.py \
#     QCFS_simulation/noise3_exp/pbs_cifar_mne_nodetach_unmatched_head_l2_seed42.pbs
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   OUT=/scratch/gs14/sl9144/snn_results/cifar_mne_nodetach_unmatched_head_l2_seed42
#   PBS=QCFS_simulation/noise3_exp/pbs_cifar_mne_nodetach_unmatched_head_l2_seed42.pbs
#
#   for ARCH in resnet18 vgg16; do
#     A=${ARCH:0:1}
#     for DS in cifar10 cifar100; do
#       TAG=${DS#cifar}
#       qsub -l walltime=08:00:00 -N "nd${TAG}${A}mn" \
#         -v CIFAR_ROOT,ARCH=${ARCH},DATASET=${DS},METHOD=mne,SEED=42,EVAL_SEED=0,TEST_ONLY=1,OUT_DIR=${OUT} \
#         ${PBS}
#       qsub -l walltime=36:00:00 -N "nd${TAG}${A}hd" \
#         -v CIFAR_ROOT,ARCH=${ARCH},DATASET=${DS},METHOD=mne_head,SEED=42,EVAL_SEED=0,OUT_DIR=${OUT} \
#         ${PBS}
#     done
#   done

set -euo pipefail

ARCH="${ARCH:?set ARCH=resnet18|vgg16}"
DATASET="${DATASET:?set DATASET=cifar10|cifar100}"
METHOD="${METHOD:?set METHOD=mne|mne_head}"
SEED="${SEED:-42}"
EVAL_SEED="${EVAL_SEED:-0}"
N_STREAMS="${N_STREAMS:-8}"
DIAG_SIGMAS="${DIAG_SIGMAS:-1,3,5}"
BODY="nodetach"
case "${ARCH}" in
  resnet18|vgg16) ;;
  *) echo "ERROR: invalid ARCH=${ARCH}"; exit 2 ;;
esac
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac
case "${METHOD}" in
  mne|mne_head|l2wo|mne_unmatched) ;;
  *) echo "ERROR: invalid METHOD=${METHOD}"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/mnendhd_${ARCH}_${DATASET}_${METHOD}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export N_STREAMS
export DIAG_SIGMAS

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_mne_nodetach_unmatched_head_l2_seed42}"
mkdir -p "${OUT_DIR}"
echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) ARCH=${ARCH} DATASET=${DATASET} METHOD=${METHOD} BODY=${BODY} SEED=${SEED} EVAL_SEED=${EVAL_SEED}"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR} TEST_ONLY=${TEST_ONLY:-0} RETRAIN=${RETRAIN:-0}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

ARGS=(
  --arch "${ARCH}"
  --dataset "${DATASET}"
  --method "${METHOD}"
  --body "${BODY}"
  --seed "${SEED}"
  --eval-seed "${EVAL_SEED}"
  --n-streams "${N_STREAMS}"
  --sigmas "${DIAG_SIGMAS}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi
if [[ "${SKIP_DIAG:-0}" == "1" ]]; then
  ARGS+=(--skip-diag)
fi

python -u noise3_exp/run_cifar_mne_unmatched_head_l2_seed42.py "${ARGS[@]}"
echo "DONE $(date)"
