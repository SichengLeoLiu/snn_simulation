#!/bin/bash
#PBS -N imgfgu
#PBS -P gs14
#PBS -q gpuhopper
#PBS -l walltime=48:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=256GB
#PBS -l jobfs=400GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# ImageNet ResNet-18 seed42 FG-MNE-U screen on H200 (gpuhopper).
# METHOD: detach | nodetach | fgmneu
# l2wo is reuse-only (five-regs checkpoint + existing noise matrix).
# All three trains use the resnet layer map. Do not reuse five-regs old_detach
# (that run used the default legacy map).
# Locked: η_MNE=1e-4, η_U=1e-4 (ImageNet L2-wo WD). Do not retune from test.
# Checkpoints and logs MUST stay on scratch (home quota).
#
#   cd /home/595/sl9144/codes/snn_simulation
#   git fetch origin codex/task-cov-mne-resnet18
#   git checkout origin/codex/task-cov-mne-resnet18 -- \
#     QCFS_simulation/noise3_exp/run_imagenet_resnet18_fgmneu_seed42.py \
#     QCFS_simulation/noise3_exp/pbs_imagenet_resnet18_fgmneu_seed42.pbs
#   source QCFS_simulation/scripts/setup_gadi_imagenet.sh
#   OUT=/scratch/gs14/sl9144/snn_results/imagenet_resnet18_fgmneu_seed42
#   CKPT=${OUT}/ckpts
#   PBS=QCFS_simulation/noise3_exp/pbs_imagenet_resnet18_fgmneu_seed42.pbs
#   qsub -N imgdet -v METHOD=detach,OUT_DIR=${OUT},IMAGENET_CKPT_ROOT=${CKPT} ${PBS}
#   qsub -N imgndt -v METHOD=nodetach,OUT_DIR=${OUT},IMAGENET_CKPT_ROOT=${CKPT} ${PBS}
#   qsub -N imgfgu -v METHOD=fgmneu,OUT_DIR=${OUT},IMAGENET_CKPT_ROOT=${CKPT} ${PBS}

set -euo pipefail

METHOD="${METHOD:?set METHOD=detach|nodetach|fgmneu}"
case "${METHOD}" in
  detach|nodetach|fgmneu) ;;
  l2wo)
    echo "ERROR: l2wo is reuse-only; do not submit a training GPU job"
    exit 2
    ;;
  *)
    echo "ERROR: invalid METHOD=${METHOD}"
    exit 2
    ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/img_fgmneu_${METHOD}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1
echo "LIVE_LOG=${LIVE_LOG}"
echo "METHOD=${METHOD}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

source /home/595/sl9144/codes/snn_simulation/QCFS_simulation/scripts/setup_gadi_imagenet.sh
export IMAGENET_OFFLINE=1
export QCFS_CUDA_FAST=1
export NVIDIA_TF32_OVERRIDE=1
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export IMAGENET_EPOCHS="${IMAGENET_EPOCHS:-90}"
export IMAGENET_BATCH="${IMAGENET_BATCH:-256}"
export IMAGENET_LR="${IMAGENET_LR:-0.1}"
export IMAGENET_NUM_WORKERS="${IMAGENET_NUM_WORKERS:-8}"

ROOT=/home/595/sl9144/codes/snn_simulation/QCFS_simulation
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/imagenet_resnet18_fgmneu_seed42}"
export IMAGENET_CKPT_ROOT="${IMAGENET_CKPT_ROOT:-${OUT_DIR}/ckpts}"
mkdir -p "${OUT_DIR}" "${IMAGENET_CKPT_ROOT}" "${TMPDIR:-/scratch/gs14/sl9144/tmp}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "IMAGENET_CKPT_ROOT=${IMAGENET_CKPT_ROOT}"
echo "HF_HOME=${HF_HOME:-}"
echo "IMAGENET_OFFLINE=${IMAGENET_OFFLINE}"
echo "IMAGENET_BATCH=${IMAGENET_BATCH} IMAGENET_LR=${IMAGENET_LR} WORKERS=${IMAGENET_NUM_WORKERS}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"
echo "NOTE: FG-MNE-U = no-detach MNE + unmatched-weight L2, resnet map, η_U=1e-4"
which python
module list || true

python - <<'PY'
import torch
print("torch", torch.__version__, "cuda", torch.cuda.is_available(), "built_cuda", torch.version.cuda)
if torch.cuda.is_available():
    print("device", torch.cuda.get_device_name(0), "capability", torch.cuda.get_device_capability(0))
PY

python -u noise3_exp/run_imagenet_resnet18_fgmneu_seed42.py \
  --method "${METHOD}" \
  --epochs "${IMAGENET_EPOCHS}" \
  --lr "${IMAGENET_LR}" \
  --batch-size "${IMAGENET_BATCH}" \
  --workers "${IMAGENET_NUM_WORKERS}" \
  --first-layer-noise-position post_input_if \
  --noise-sigma-start 0.0 \
  --noise-sigma-end 5.0 \
  --noise-sigma-step 0.25 \
  --out-root "${OUT_DIR}" \
  --ckpt-root "${IMAGENET_CKPT_ROOT}"

echo "=== ALL DONE $(date) METHOD=${METHOD} ==="
ls -la "${OUT_DIR}/${METHOD}" || true
ls -la "${IMAGENET_CKPT_ROOT}/${METHOD}" || true
