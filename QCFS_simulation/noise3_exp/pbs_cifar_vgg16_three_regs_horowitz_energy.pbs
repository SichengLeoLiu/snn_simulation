#!/bin/bash
#PBS -N vgg_e
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR-10/100 VGG16 Horowitz energy table
#   Methods: L2-all / L2-wo / L1-wo / Old MNE-L2
#   Each method: ANN T=0 plus SNN T=4,8,16; seed 40-44; test-only
#
# Login 节点：
#   cd /home/595/sl9144/codes/snn_simulation && git pull
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   qsub -v CIFAR_ROOT QCFS_simulation/noise3_exp/pbs_cifar_vgg16_three_regs_horowitz_energy.pbs

set -euo pipefail

mkdir -p /home/595/sl9144/logs
LIVE_LOG="/home/595/sl9144/logs/vgg_e.${PBS_JOBID:-manual}.out"
exec > >(tee -a "${LIVE_LOG}") 2>&1
echo "LIVE_LOG=${LIVE_LOG}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-${ROOT}/../important_results/cifar_vgg16_three_regs_horowitz_energy}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "CIFAR_ROOT=${CIFAR_ROOT}"

python -u noise3_exp/measure_vgg16_horowitz_energy.py \
  --datasets cifar10 cifar100 \
  --methods l2 l2_wo l1 mne_l2 \
  --seeds 40 41 42 43 44 \
  --time-steps 4 8 16 \
  --batch-size "${CIFAR_BATCH}" \
  --workers "${CIFAR_NUM_WORKERS}" \
  --max-samples 0 \
  --out-dir "${OUT_DIR}"

echo "=== ALL DONE $(date) ==="
ls -la "${OUT_DIR}"
