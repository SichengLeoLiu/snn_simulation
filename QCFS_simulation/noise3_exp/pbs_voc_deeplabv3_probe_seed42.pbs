#!/bin/bash
#PBS -N dlv3probe
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=48:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# Residual / ASPP / pixel probes on AvgPool DeepLabV3 checkpoints.
# METHOD: original | l2wo | mne | nodetach
# TEST_ONLY on voc_deeplabv3_resnet50_avgpool_mne_seed42. σ=0.5,1.0,1.5.
#
#   export VOC_ROOT=/home/595/sl9144/datasets
#   for M in original l2wo mne nodetach; do
#     qsub -N "dlv3prb_${M}" \
#       -v VOC_ROOT,VOC_STEM_POOL=avg,VOC_SIGMA_MIN=0.5,VOC_SIGMA_MAX=1.5,VOC_SIGMA_STEP=0.5,VOC_PROBE_IMAGES=200,METHOD=${M},SEED=42,CKPT_ROOT=/scratch/gs14/sl9144/snn_results/voc_deeplabv3_resnet50_avgpool_mne_seed42,OUT_DIR=/scratch/gs14/sl9144/snn_results/voc_deeplabv3_resnet50_avgpool_probe_seed42 \
#       QCFS_simulation/noise3_exp/pbs_voc_deeplabv3_probe_seed42.pbs
#   done

set -euo pipefail

METHOD="${METHOD:?set METHOD=original|l2wo|mne|nodetach}"
SEED="${SEED:-42}"
STEM_POOL="${VOC_STEM_POOL:-avg}"

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/deeplabv3_probe_${STEM_POOL}_${METHOD}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1
echo "LIVE_LOG=${LIVE_LOG}"
echo "METHOD=${METHOD} SEED=${SEED} STEM_POOL=${STEM_POOL} SIGMA=${VOC_SIGMA_MIN:-0.5}-${VOC_SIGMA_MAX:-1.5} step=${VOC_SIGMA_STEP:-0.5}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export VOC_ROOT="${VOC_ROOT:-/home/595/sl9144/datasets}"
export VOC_NUM_WORKERS="${VOC_NUM_WORKERS:-4}"
export VOC_EVAL_T="${VOC_EVAL_T:-16}"
export VOC_PROBE_IMAGES="${VOC_PROBE_IMAGES:-200}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export TORCH_HOME="${TORCH_HOME:-${HOME}/.cache/torch}"

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

CKPT_ROOT="${CKPT_ROOT:-/scratch/gs14/sl9144/snn_results/voc_deeplabv3_resnet50_avgpool_mne_seed42}"
OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/voc_deeplabv3_resnet50_avgpool_probe_seed42}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "CKPT_ROOT=${CKPT_ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

CKPT="${CKPT_ROOT}/${METHOD}/checkpoints/deeplabv3_resnet50_L[16]_${METHOD}_seed${SEED}_L16_trainT0.pth"
if [[ ! -f "${CKPT}" ]]; then
  echo "ERROR: missing checkpoint ${CKPT}"
  ls -la "${CKPT_ROOT}/${METHOD}/checkpoints" || true
  exit 1
fi

ARGS=(
  --method "${METHOD}"
  --seed "${SEED}"
  --stem-pool "${STEM_POOL}"
  --voc-root "${VOC_ROOT}"
  --ckpt-root "${CKPT_ROOT}"
  --out-root "${OUT_DIR}"
  --workers "${VOC_NUM_WORKERS}"
  --eval-t "${VOC_EVAL_T}"
  --max-images "${VOC_PROBE_IMAGES}"
)
if [[ -n "${VOC_SIGMA_MIN:-}" ]]; then
  ARGS+=(--sigma-min "${VOC_SIGMA_MIN}")
fi
if [[ -n "${VOC_SIGMA_MAX:-}" ]]; then
  ARGS+=(--sigma-max "${VOC_SIGMA_MAX}")
fi
if [[ -n "${VOC_SIGMA_STEP:-}" ]]; then
  ARGS+=(--sigma-step "${VOC_SIGMA_STEP}")
fi
if [[ "${SELF_CHECK:-0}" == "1" ]]; then
  ARGS=(--self-check)
fi

python -u noise3_exp/run_voc_deeplabv3_probe_seed42.py "${ARGS[@]}"

echo "=== ALL DONE $(date) METHOD=${METHOD} ==="
ls -la "${OUT_DIR}/${METHOD}" || ls -la "${OUT_DIR}"
