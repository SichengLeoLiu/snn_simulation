#!/bin/bash
#PBS -N mneuhd
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# P0/P1 seed-42: MNE-L2 + unmatched Conv/Linear L2.
# ARCH: resnet18 | vgg16
# DATASET: cifar10 | cifar100
# METHOD: l2wo | mne | mne_head | mne_unmatched
#
# l2wo / mne are eval-only reuse. mne_head is the unique hybrid train.
# On these two models unmatched-all == classifier head, so do not also
# submit mne_unmatched unless you want a duplicate GPU job.
#
# η_MNE=1e-4, η_head=5e-4 (locked to L2-wo). Do not retune from test.
# Shared test noise: EVAL_SEED=0. T=L=16 rate_uniform post-input-IF.
#
#   cd /home/595/sl9144/codes/snn_simulation
#   git fetch origin codex/task-cov-mne-resnet18
#   git checkout origin/codex/task-cov-mne-resnet18 -- \
#     QCFS_simulation/utils.py \
#     QCFS_simulation/main_train.py \
#     QCFS_simulation/noise3_exp/run_cifar_mne_unmatched_head_l2_seed42.py \
#     QCFS_simulation/noise3_exp/pbs_cifar_mne_unmatched_head_l2_seed42.pbs
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   OUT=/scratch/gs14/sl9144/snn_results/cifar_mne_unmatched_head_l2_seed42
#
#   # 8 eval-only reuse jobs
#   for ARCH in resnet18 vgg16; do
#     A=${ARCH:0:1}
#     for DS in cifar10 cifar100; do
#       TAG=${DS#cifar}
#       for M in l2wo mne; do
#         MS=${M:0:2}
#         qsub -l walltime=08:00:00 -N "uh${TAG}${A}${MS}" \
#           -v CIFAR_ROOT,ARCH=${ARCH},DATASET=${DS},METHOD=${M},SEED=42,EVAL_SEED=0,TEST_ONLY=1,OUT_DIR=${OUT} \
#           QCFS_simulation/noise3_exp/pbs_cifar_mne_unmatched_head_l2_seed42.pbs
#       done
#     done
#   done
#
#   # 4 hybrid trains
#   for ARCH in resnet18 vgg16; do
#     A=${ARCH:0:1}
#     for DS in cifar10 cifar100; do
#       TAG=${DS#cifar}
#       qsub -N "uh${TAG}${A}hd" \
#         -v CIFAR_ROOT,ARCH=${ARCH},DATASET=${DS},METHOD=mne_head,SEED=42,EVAL_SEED=0,OUT_DIR=${OUT} \
#         QCFS_simulation/noise3_exp/pbs_cifar_mne_unmatched_head_l2_seed42.pbs
#     done
#   done

set -euo pipefail

ARCH="${ARCH:?set ARCH=resnet18|vgg16}"
DATASET="${DATASET:?set DATASET=cifar10|cifar100}"
METHOD="${METHOD:?set METHOD=l2wo|mne|mne_head|mne_unmatched}"
SEED="${SEED:-42}"
EVAL_SEED="${EVAL_SEED:-0}"
N_STREAMS="${N_STREAMS:-8}"
DIAG_SIGMAS="${DIAG_SIGMAS:-1,3,5}"
case "${ARCH}" in
  resnet18|vgg16) ;;
  *) echo "ERROR: invalid ARCH=${ARCH}"; exit 2 ;;
esac
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac
case "${METHOD}" in
  l2wo|mne|mne_head|mne_unmatched) ;;
  *) echo "ERROR: invalid METHOD=${METHOD}"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/mneuhd_${ARCH}_${DATASET}_${METHOD}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export N_STREAMS
export DIAG_SIGMAS

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_mne_unmatched_head_l2_seed42}"
mkdir -p "${OUT_DIR}"
echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) ARCH=${ARCH} DATASET=${DATASET} METHOD=${METHOD} SEED=${SEED} EVAL_SEED=${EVAL_SEED}"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR} TEST_ONLY=${TEST_ONLY:-0} RETRAIN=${RETRAIN:-0}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

ARGS=(
  --arch "${ARCH}"
  --dataset "${DATASET}"
  --method "${METHOD}"
  --seed "${SEED}"
  --eval-seed "${EVAL_SEED}"
  --n-streams "${N_STREAMS}"
  --sigmas "${DIAG_SIGMAS}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi
if [[ "${SKIP_DIAG:-0}" == "1" ]]; then
  ARGS+=(--skip-diag)
fi

python -u noise3_exp/run_cifar_mne_unmatched_head_l2_seed42.py "${ARGS[@]}"
echo "DONE $(date)"
