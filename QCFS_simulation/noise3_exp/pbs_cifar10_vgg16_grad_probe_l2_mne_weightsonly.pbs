#!/bin/bash
#PBS -N gradprobe_wo
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=48:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR-10 VGG16：weights-only 显式 L2 + MNE-L2-standard
# 训练中 early/mid/late 分解 CE vs reg 对 λ / BN-γ 的梯度
#
# 注意：必须用显式正则。optimizer --regularizer weight_decay_weights_only
# 没有可分解的 reg loss，--grad_probe 会直接报错。
#
# Login 节点提交：
#   mkdir -p ~/logs
#   cd /home/595/sl9144/codes/snn_simulation && git pull
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   qsub -v CIFAR_ROOT QCFS_simulation/noise3_exp/pbs_cifar10_vgg16_grad_probe_l2_mne_weightsonly.pbs
#   qstat -u $USER
#
# 实时日志：
#   ls -lt ~/logs/grad_probe_l2_mne_wo.*.out | head
#   tail -f ~/logs/grad_probe_l2_mne_wo.${PBS_JOBID}.out

set -euo pipefail

mkdir -p /home/595/sl9144/logs
LIVE_LOG="/home/595/sl9144/logs/grad_probe_l2_mne_wo.${PBS_JOBID:-manual}.out"
exec > >(tee -a "${LIVE_LOG}") 2>&1
echo "LIVE_LOG=${LIVE_LOG}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-${ROOT}/../important_results/cifar10_vgg16_grad_probe_l2_mne_weightsonly_seed42}"
mkdir -p "${OUT_DIR}/manual_l2" "${OUT_DIR}/mne_l2"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "CIFAR_ROOT=${CIFAR_ROOT}"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-}"
if [[ ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  echo "Expected: ${CIFAR_ROOT}/cifar-10-batches-py/batches.meta"
  exit 1
fi

python - <<'PY'
import torch
print("torch", torch.__version__, "cuda", torch.cuda.is_available())
if torch.cuda.is_available():
    print("device", torch.cuda.get_device_name(0))
else:
    print("WARNING: CUDA not available")
PY

# ---------- 1) L2 weights-only：显式 sum(||W||^2)，仅 Conv/Linear weight ----------
# rc=2.5e-4 的梯度尺度 ≈ SGD weight_decay=5e-4
echo "=== START manual_l2 (weights-only) $(date) ==="
python -u main_train.py \
  -data cifar10 \
  -arch vgg16 \
  -T 0 \
  -L 16 \
  --epochs 300 \
  -lr 0.1 \
  -b "${CIFAR_BATCH}" \
  -j "${CIFAR_NUM_WORKERS}" \
  --seed 42 \
  --regularizer manual_l2 \
  --reg_coeff 2.5e-4 \
  --weight_decay 0 \
  -suffix gradprobe_L2wo_seed42_L16 \
  --ckpt-save-mode last \
  --grad_probe \
  --grad_probe_epochs auto \
  --grad_probe_csv "${OUT_DIR}/manual_l2/seed42_grad_probe.csv"
echo "=== DONE manual_l2 $(date) ==="

# ---------- 2) MNE-L2-standard：只惩罚 matched Conv/Linear 的有效权重能量 ----------
echo "=== START mne_l2 (weights-only / standard) $(date) ==="
python -u main_train.py \
  -data cifar10 \
  -arch vgg16 \
  -T 0 \
  -L 16 \
  --epochs 300 \
  -lr 0.1 \
  -b "${CIFAR_BATCH}" \
  -j "${CIFAR_NUM_WORKERS}" \
  --seed 42 \
  --regularizer mne_l2 \
  --reg_coeff 1e-4 \
  --weight_decay 0 \
  --mne_detach_lambda \
  -suffix gradprobe_MNEwo_seed42_L16 \
  --ckpt-save-mode last \
  --grad_probe \
  --grad_probe_epochs auto \
  --grad_probe_csv "${OUT_DIR}/mne_l2/seed42_grad_probe.csv"
echo "=== DONE mne_l2 $(date) ==="

echo "=== ALL DONE $(date) ==="
echo "Probes:"
ls -la "${OUT_DIR}/manual_l2/seed42_grad_probe.csv" "${OUT_DIR}/mne_l2/seed42_grad_probe.csv"
