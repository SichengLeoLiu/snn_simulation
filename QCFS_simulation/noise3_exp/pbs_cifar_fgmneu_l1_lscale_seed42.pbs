#!/bin/bash
#PBS -N fglscale
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR seed-42 FG-MNE-U / L1-wo at L=T in {4,8,32}.
# Locked: FG-MNE-U η_MNE=1e-4 η_U=5e-4; L1-wo rc=1e-5. Do not retune.
# Default arch=vgg16 to match existing L2 lscale. Do not train L=16.
# New directory only. Do not overwrite l2/mne lscale, four-regs, or ImageNet.
#
#   cd /home/595/sl9144/codes/snn_simulation
#   git fetch origin codex/task-cov-mne-resnet18
#   git checkout origin/codex/task-cov-mne-resnet18 -- \
#     QCFS_simulation/noise3_exp/run_cifar_fgmneu_l1_lscale_seed42.py \
#     QCFS_simulation/noise3_exp/pbs_cifar_fgmneu_l1_lscale_seed42.pbs
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   PBS=QCFS_simulation/noise3_exp/pbs_cifar_fgmneu_l1_lscale_seed42.pbs
#   OUT=/scratch/gs14/sl9144/snn_results/cifar_fgmneu_l1_lscale_seed42
#   for DS in cifar10 cifar100; do
#     TAG=${DS#cifar}
#     for M in fgmneu l1wo; do
#       for L in 4 8 32; do
#         qsub -N "fl${TAG}${M}_L${L}" -l walltime=24:00:00 \
#           -v CIFAR_ROOT,DATASET=${DS},METHOD=${M},QUANT_L=${L},OUT_DIR=${OUT} ${PBS}
#       done
#     done
#   done

set -euo pipefail

ARCH="${ARCH:-vgg16}"
DATASET="${DATASET:?set DATASET=cifar10|cifar100}"
METHOD="${METHOD:?set METHOD=fgmneu|l1wo}"
QUANT_L="${QUANT_L:?set QUANT_L=4|8|32}"
SEED="${SEED:-42}"

case "${ARCH}" in
  vgg16|resnet18) ;;
  *) echo "ERROR: invalid ARCH=${ARCH}"; exit 2 ;;
esac
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac
case "${METHOD}" in
  fgmneu|l1wo) ;;
  *) echo "ERROR: invalid METHOD=${METHOD}"; exit 2 ;;
esac
case "${QUANT_L}" in
  4|8|32) ;;
  16)
    echo "ERROR: L=16 already exists; this PBS refuses to train it"
    exit 2
    ;;
  *) echo "ERROR: invalid QUANT_L=${QUANT_L}"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/fglscale_${ARCH}_${DATASET}_${METHOD}_L${QUANT_L}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_fgmneu_l1_lscale_seed42}"
mkdir -p "${OUT_DIR}"

echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) ARCH=${ARCH} DATASET=${DATASET} METHOD=${METHOD} L=${QUANT_L} SEED=${SEED}"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"
echo "NOTE: locked η; do not retune; do not write l2/mne lscale or ImageNet dirs"

if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

ARGS=(
  --arch "${ARCH}"
  --dataset "${DATASET}"
  --method "${METHOD}"
  --quant-L "${QUANT_L}"
  --seed "${SEED}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi

python -u noise3_exp/run_cifar_fgmneu_l1_lscale_seed42.py "${ARGS[@]}"

echo "DONE $(date) ${DATASET} ${ARCH} ${METHOD} L=${QUANT_L}"
ls -la "${OUT_DIR}/${DATASET}/${ARCH}_${METHOD}_L${QUANT_L}" || true
