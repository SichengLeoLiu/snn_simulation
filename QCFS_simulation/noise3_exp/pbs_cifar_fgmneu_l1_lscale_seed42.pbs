#!/bin/bash
#PBS -N fglscale
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR FG-MNE-U / L1-wo at L=T in {4,8,32}.
# Locked: FG-MNE-U η_MNE=1e-4 η_U=5e-4; L1-wo rc=1e-5. Do not retune.
# Default arch=vgg16. Do not train L=16.
# DATASET: cifar10 | cifar100 | both
#   both -> C10 then C100 on same GPU (sequential). Use 1 GPU / 80GB.
#   PARALLEL_BOTH=1 + ngpus>=2 -> parallel on GPU0/1.
# Multi-seed: set OUT_DIR per seed (cfg_dir has no seed folder).

set -euo pipefail

ARCH="${ARCH:-vgg16}"
DATASET="${DATASET:?set DATASET=cifar10|cifar100|both}"
METHOD="${METHOD:?set METHOD=fgmneu|l1wo}"
QUANT_L="${QUANT_L:?set QUANT_L=4|8|32}"
SEED="${SEED:-42}"

case "${ARCH}" in
  vgg16|resnet18) ;;
  *) echo "ERROR: invalid ARCH=${ARCH}"; exit 2 ;;
esac
case "${DATASET}" in
  cifar10|cifar100|both) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac
case "${METHOD}" in
  fgmneu|l1wo) ;;
  *) echo "ERROR: invalid METHOD=${METHOD}"; exit 2 ;;
esac
case "${QUANT_L}" in
  4|8|32) ;;
  16)
    echo "ERROR: L=16 already exists; this PBS refuses to train it"
    exit 2
    ;;
  *) echo "ERROR: invalid QUANT_L=${QUANT_L}"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/fglscale_${ARCH}_${DATASET}_${METHOD}_L${QUANT_L}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_fgmneu_l1_lscale_seed42}"
mkdir -p "${OUT_DIR}"

echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) ARCH=${ARCH} DATASET=${DATASET} METHOD=${METHOD} L=${QUANT_L} SEED=${SEED}"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR}"
echo "ngpus=${PBS_NGPUS:-?} ncpus=${PBS_NCPUS:-?}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"
echo "NOTE: locked η; do not retune; do not write l2/mne lscale or ImageNet dirs"

if [[ ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

run_one() {
  local ds="$1"
  local gpu="$2"
  local log="${SCRATCH_LOG}/fglscale_${ARCH}_${ds}_${METHOD}_L${QUANT_L}_seed${SEED}.${PBS_JOBID:-manual}.gpu${gpu}.out"
  local args=(
    --arch "${ARCH}"
    --dataset "${ds}"
    --method "${METHOD}"
    --quant-L "${QUANT_L}"
    --seed "${SEED}"
    --out-root "${OUT_DIR}"
    --batch-size "${CIFAR_BATCH}"
    --workers "${CIFAR_NUM_WORKERS}"
  )
  if [[ "${TEST_ONLY:-0}" == "1" ]]; then
    args+=(--test-only)
  fi
  if [[ "${RETRAIN:-0}" == "1" ]]; then
    args+=(--retrain)
  fi
  echo "[LAUNCH] ds=${ds} gpu=${gpu} log=${log}"
  CUDA_VISIBLE_DEVICES="${gpu}" python -u noise3_exp/run_cifar_fgmneu_l1_lscale_seed42.py "${args[@]}" \
    >"${log}" 2>&1
  echo "[DONE] ds=${ds} gpu=${gpu}"
}

if [[ "${DATASET}" == "both" ]]; then
  if [[ "${PARALLEL_BOTH:-0}" == "1" ]]; then
    if [[ "${PBS_NGPUS:-1}" -lt 2 ]]; then
      echo "ERROR: PARALLEL_BOTH=1 needs ngpus>=2"
      exit 2
    fi
    echo "[MODE] DATASET=both parallel on GPU0/GPU1"
    run_one cifar10 0 &
    pid10=$!
    run_one cifar100 1 &
    pid100=$!
    status=0
    wait "${pid10}" || status=1
    wait "${pid100}" || status=1
    if [[ "${status}" -ne 0 ]]; then
      echo "ERROR: one or both dataset workers failed"
      exit 1
    fi
  else
    echo "[MODE] DATASET=both sequential on GPU0 (cifar10 then cifar100)"
    run_one cifar10 0
    run_one cifar100 0
  fi
else
  run_one "${DATASET}" 0
fi

echo "DONE $(date) ${DATASET} ${ARCH} ${METHOD} L=${QUANT_L}"
ls -la "${OUT_DIR}/cifar10" "${OUT_DIR}/cifar100" 2>/dev/null || true
