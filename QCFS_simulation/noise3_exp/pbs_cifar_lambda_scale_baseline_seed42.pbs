#!/bin/bash
#PBS -N lamsc
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=12:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR seed-42 threshold-scaling baseline vs λ-MNE-U.
# ARM=scale : eval-only, multiply L2-wo IF-λ by a fixed grid, select on val.
# ARM=grow  : train L2-wo + R=-mean(log λ), η_λ=GROW_COEFF. Do not retune from test.
# New directories only. Do not overwrite L2-wo / FG-MNE-U / λ-MNE-U / ImageNet.
#
#   cd /home/595/sl9144/codes/snn_simulation
#   git fetch origin codex/task-cov-mne-resnet18
#   git checkout origin/codex/task-cov-mne-resnet18 -- \
#     QCFS_simulation/lambda_grow.py \
#     QCFS_simulation/main_train.py \
#     QCFS_simulation/noise3_exp/run_cifar_lambda_scale_baseline_seed42.py \
#     QCFS_simulation/noise3_exp/pbs_cifar_lambda_scale_baseline_seed42.pbs
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   python QCFS_simulation/noise3_exp/run_cifar_lambda_scale_baseline_seed42.py --self-check
#   PBS=QCFS_simulation/noise3_exp/pbs_cifar_lambda_scale_baseline_seed42.pbs
#
#   # Wave 1: post-hoc λ×s on L2-wo (eval only)
#   OUTS=/scratch/gs14/sl9144/snn_results/cifar_lambda_scale_baseline_seed42
#   for ARCH in vgg16 resnet18; do
#     for DS in cifar10 cifar100; do
#       TAG="${ARCH:0:1}${DS#cifar}"
#       qsub -N "ls${TAG}" -l walltime=12:00:00 \
#         -v CIFAR_ROOT,ARM=scale,ARCH=${ARCH},DATASET=${DS},OUT_DIR=${OUTS} ${PBS}
#     done
#   done
#
#   # Wave 2: L2-wo + λ-grow (VGG first; locked η_λ grid)
#   OUTG=/scratch/gs14/sl9144/snn_results/cifar_l2wo_lambda_grow_seed42
#   for DS in cifar10 cifar100; do
#     for C in 0.01 0.03 0.1; do
#       qsub -N "lg${DS#cifar}_${C}" -l walltime=24:00:00 \
#         -v CIFAR_ROOT,ARM=grow,ARCH=vgg16,DATASET=${DS},GROW_COEFF=${C},OUT_DIR=${OUTG} ${PBS}
#     done
#   done

set -euo pipefail

ARM="${ARM:?set ARM=scale|grow}"
ARCH="${ARCH:-vgg16}"
DATASET="${DATASET:?set DATASET=cifar10|cifar100}"
SEED="${SEED:-42}"
EVAL_SEED="${EVAL_SEED:-0}"
case "${ARM}" in
  scale|grow) ;;
  *) echo "ERROR: invalid ARM=${ARM}"; exit 2 ;;
esac
case "${ARCH}" in
  vgg16|resnet18) ;;
  *) echo "ERROR: invalid ARCH=${ARCH}"; exit 2 ;;
esac
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac
if [[ "${ARM}" == "grow" && -z "${GROW_COEFF:-}" ]]; then
  echo "ERROR: grow arm needs GROW_COEFF"
  exit 2
fi

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/lamsc_${ARM}_${ARCH}_${DATASET}_${GROW_COEFF:-s}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

if [[ "${ARM}" == "scale" ]]; then
  OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_lambda_scale_baseline_seed42}"
else
  OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_l2wo_lambda_grow_seed42}"
fi
mkdir -p "${OUT_DIR}"
echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) ARM=${ARM} ARCH=${ARCH} DATASET=${DATASET} SEED=${SEED}"
echo "GROW_COEFF=${GROW_COEFF:-} ROOT=${ROOT} OUT_DIR=${OUT_DIR}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"
echo "NOTE: threshold-scaling baseline; do not retune; do not touch ImageNet"

if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

ARGS=(
  --arm "${ARM}"
  --arch "${ARCH}"
  --dataset "${DATASET}"
  --seed "${SEED}"
  --eval-seed "${EVAL_SEED}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${ARM}" == "grow" ]]; then
  ARGS+=(--grow-coeff "${GROW_COEFF}")
fi
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi

python -u noise3_exp/run_cifar_lambda_scale_baseline_seed42.py "${ARGS[@]}"
echo "DONE $(date) ARM=${ARM} ARCH=${ARCH} DATASET=${DATASET}"
ls -la "${OUT_DIR}/${DATASET}" || true
