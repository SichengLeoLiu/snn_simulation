#!/bin/bash
#PBS -N hybenv
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR-10/100 VGG16 envelope screen. Logs and default OUT_DIR live on
# scratch: home quota cannot hold PBS stdout or sweep CSVs.
#
# Login:
#   cd /home/595/sl9144/codes/snn_simulation && git pull
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   qsub -l walltime=06:00:00 -v CIFAR_ROOT,DATASET=cifar10,SEED=40,FAMILY=onesided,ALPHA=4,TAU=0.5,BETA=5e-4,RMAX=8,TEST_ONLY=1 \
#     QCFS_simulation/noise3_exp/pbs_cifar100_vgg16_hybrid_envelope_screen_seed42.pbs

set -euo pipefail

FAMILY="${FAMILY:?set FAMILY=hybrid or onesided}"
DATASET="${DATASET:-cifar100}"
SEED="${SEED:-42}"

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/hybenv_${DATASET}_seed${SEED}_${FAMILY}_${ALPHA:-}_${RMAX:-}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1
echo "LIVE_LOG=${LIVE_LOG}"
echo "DATASET=${DATASET} SEED=${SEED} FAMILY=${FAMILY} BETA0=${BETA0:-} BETA1=${BETA1:-} ALPHA=${ALPHA:-} TAU=${TAU:-} BETA=${BETA:-} RMAX=${RMAX:-} TEST_ONLY=${TEST_ONLY:-0}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/${DATASET}_vgg16_hybrid_envelope_screen_seed${SEED}}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "CIFAR_ROOT=${CIFAR_ROOT}"

if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

ARGS=(
  --dataset "${DATASET}"
  --seed "${SEED}"
  --family "${FAMILY}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${FAMILY}" == "hybrid" ]]; then
  ARGS+=(--beta0 "${BETA0:?}" --beta1 "${BETA1:?}")
else
  ARGS+=(--alpha "${ALPHA:-0.1}" --tau "${TAU:-1.0}" --beta "${BETA:-5e-4}" --risk-max "${RMAX:-2}")
fi

python -u noise3_exp/run_cifar_vgg16_hybrid_envelope_screen.py "${ARGS[@]}"

echo "=== ALL DONE $(date) FAMILY=${FAMILY} DATASET=${DATASET} ==="
ls -la "${OUT_DIR}"
