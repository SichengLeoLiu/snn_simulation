#!/bin/bash
#PBS -N fggabl
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=36:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR VGG-16 FG-MNE-U γ/λ ablation, seed 42, V100.
# DATASET: cifar10 | cifar100
# GRAD: gamma | lambda
# detach and full are reuse-only (already trained). Do not retune η.
#
#   cd /home/595/sl9144/codes/snn_simulation
#   git fetch origin codex/task-cov-mne-resnet18
#   git checkout origin/codex/task-cov-mne-resnet18 -- \
#     QCFS_simulation/noise3_exp/run_cifar_fgmneu_grad_ablation_seed42.py \
#     QCFS_simulation/noise3_exp/pbs_cifar_fgmneu_grad_ablation_seed42.pbs
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   OUT=/scratch/gs14/sl9144/snn_results/cifar_fgmneu_grad_ablation_seed42
#   PBS=QCFS_simulation/noise3_exp/pbs_cifar_fgmneu_grad_ablation_seed42.pbs
#   for DS in cifar10 cifar100; do
#     TAG=${DS#cifar}
#     for G in gamma lambda; do
#       qsub -l walltime=36:00:00 -N "fg${G:0:1}${TAG}" \
#         -v CIFAR_ROOT,DATASET=${DS},GRAD=${G},SEED=42,EVAL_SEED=0,OUT_DIR=${OUT} \
#         ${PBS}
#     done
#   done

set -euo pipefail

DATASET="${DATASET:?set DATASET=cifar10|cifar100}"
GRAD="${GRAD:?set GRAD=gamma|lambda}"
SEED="${SEED:-42}"
EVAL_SEED="${EVAL_SEED:-0}"
N_STREAMS="${N_STREAMS:-8}"
DIAG_SIGMAS="${DIAG_SIGMAS:-1,3,5}"
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac
case "${GRAD}" in
  gamma|lambda) ;;
  detach|full)
    echo "ERROR: ${GRAD} is reuse-only; do not submit a GPU job"
    exit 2
    ;;
  *) echo "ERROR: invalid GRAD=${GRAD}"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/fgmneu_${DATASET}_${GRAD}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export N_STREAMS
export DIAG_SIGMAS

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_fgmneu_grad_ablation_seed42}"
mkdir -p "${OUT_DIR}"
echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) DATASET=${DATASET} GRAD=${GRAD} SEED=${SEED}"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"
echo "NOTE: FG-MNE-U unmatched L2 on; only ∇γ/∇λ of the MNE term change"

ARGS=(
  --dataset "${DATASET}"
  --grad "${GRAD}"
  --seed "${SEED}"
  --eval-seed "${EVAL_SEED}"
  --n-streams "${N_STREAMS}"
  --sigmas "${DIAG_SIGMAS}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi

python -u noise3_exp/run_cifar_fgmneu_grad_ablation_seed42.py "${ARGS[@]}"
echo "DONE $(date)"
