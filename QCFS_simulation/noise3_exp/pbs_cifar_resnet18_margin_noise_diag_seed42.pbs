#!/bin/bash
#PBS -N r18mndiag
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=08:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# Checkpoint-only margin / s_m / layer-scale diagnostic. No training.
# METHOD: l2wo | mne
# DATASET: cifar10 | cifar100
# Shared streams: EVAL_SEED + {0..N_STREAMS-1}. Default N_STREAMS=8, σ=1,3,5.
#
# Copy the two new files onto Gadi first (do not git pull the whole tree):
#   scp QCFS_simulation/noise3_exp/run_cifar_resnet18_margin_noise_diag_seed42.py \
#       QCFS_simulation/noise3_exp/pbs_cifar_resnet18_margin_noise_diag_seed42.pbs \
#       gadi:~/codes/snn_simulation/QCFS_simulation/noise3_exp/
#
#   cd ~/codes/snn_simulation
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   for DS in cifar10 cifar100; do
#     for M in l2wo mne; do
#       qsub -N "mn${DS#cifar}${M:0:3}" \
#         -v CIFAR_ROOT,DATASET=${DS},METHOD=${M},SEED=42,EVAL_SEED=0,N_STREAMS=8 \
#         QCFS_simulation/noise3_exp/pbs_cifar_resnet18_margin_noise_diag_seed42.pbs
#     done
#   done

set -euo pipefail

METHOD="${METHOD:?set METHOD=l2wo|mne}"
DATASET="${DATASET:-cifar10}"
SEED="${SEED:-42}"
EVAL_SEED="${EVAL_SEED:-0}"
N_STREAMS="${N_STREAMS:-8}"
DIAG_SIGMAS="${DIAG_SIGMAS:-1,3,5}"
case "${METHOD}" in
  l2wo|mne) ;;
  *) echo "ERROR: invalid METHOD=${METHOD}"; exit 2 ;;
esac
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/r18mndiag_${DATASET}_${METHOD}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export N_STREAMS
export DIAG_SIGMAS
export L2WO_ROOT="${L2WO_ROOT:-/scratch/gs14/sl9144/snn_results/cifar_resnet18_four_regs_5seed}"
export MNE_ROOT="${MNE_ROOT:-/scratch/gs14/sl9144/snn_results/cifar_resnet18_fair_mne_detach}"

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_resnet18_margin_noise_diag_seed42}"
mkdir -p "${OUT_DIR}"
echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) DATASET=${DATASET} METHOD=${METHOD} SEED=${SEED} EVAL_SEED=${EVAL_SEED} N_STREAMS=${N_STREAMS}"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR}"
echo "L2WO_ROOT=${L2WO_ROOT}"
echo "MNE_ROOT=${MNE_ROOT}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

python -u noise3_exp/run_cifar_resnet18_margin_noise_diag_seed42.py \
  --dataset "${DATASET}" \
  --method "${METHOD}" \
  --seed "${SEED}" \
  --eval-seed "${EVAL_SEED}" \
  --n-streams "${N_STREAMS}" \
  --sigmas "${DIAG_SIGMAS}" \
  --out-root "${OUT_DIR}" \
  --batch-size "${CIFAR_BATCH}" \
  --workers "${CIFAR_NUM_WORKERS}"
echo "DONE $(date)"
