#!/bin/bash
#PBS -N r18taskcov
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# P1: ResNet-18 Task-Cov screen. METHOD: cov_mne | task_cov_mne
# DATASET: cifar10 | cifar100. SEED: 40–44. Shared test noise: EVAL_SEED=0.
# Extra eval-noise re-eval (TEST_ONLY). Skip cifar100 cov_mne seed42 until
# the RETRAIN job finishes. Use EXTRA_EVAL=1 (seeds 1:2:3:4). Do not put
# commas in PBS -v values. Canonical EVAL_SEED=0 scorecards are not overwritten.
#
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   for DS in cifar10 cifar100; do
#     for M in cov_mne task_cov_mne; do
#       for S in 40 41 42 43 44; do
#         qsub -N "t${DS#cifar}${M:0:1}${S}" \
#           -v CIFAR_ROOT,DATASET=${DS},METHOD=${M},SEED=${S},EVAL_SEED=0,OUT_DIR=/scratch/gs14/sl9144/snn_results/cifar_resnet18_task_cov_mne_seed42 \
#           QCFS_simulation/noise3_exp/pbs_cifar_resnet18_task_cov_mne_seed42.pbs
#       done
#     done
#   done

set -euo pipefail

METHOD="${METHOD:?set METHOD=cov_mne|task_cov_mne}"
DATASET="${DATASET:-cifar100}"
SEED="${SEED:-42}"
EVAL_SEED="${EVAL_SEED:-0}"
case "${METHOD}" in
  cov_mne|task_cov_mne) ;;
  *) echo "ERROR: invalid METHOD=${METHOD}"; exit 2 ;;
esac
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/r18taskcov_${DATASET}_${METHOD}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_resnet18_task_cov_mne_seed42}"
mkdir -p "${OUT_DIR}"
echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) DATASET=${DATASET} METHOD=${METHOD} SEED=${SEED} EVAL_SEED=${EVAL_SEED} EXTRA_EVAL_SEEDS=${EXTRA_EVAL_SEEDS:-} TEST_ONLY=${TEST_ONLY:-0} RETRAIN=${RETRAIN:-0}"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

ARGS=(
  --dataset "${DATASET}"
  --method "${METHOD}"
  --seed "${SEED}"
  --eval-seed "${EVAL_SEED}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi
if [[ "${EXTRA_EVAL:-0}" == "1" && -z "${EXTRA_EVAL_SEEDS:-}" ]]; then
  EXTRA_EVAL_SEEDS="1:2:3:4"
fi
if [[ -n "${EXTRA_EVAL_SEEDS:-}" ]]; then
  ARGS+=(--extra-eval-seeds "${EXTRA_EVAL_SEEDS}")
fi

python -u noise3_exp/run_cifar_resnet18_task_cov_mne_seed42.py "${ARGS[@]}"
echo "DONE $(date)"
