#!/bin/bash
#PBS -N v16mnec
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR VGG-16 seed-42 MNE-L2 component ablation (paper main-text table).
# VARIANT: l2wo | effective | mne | nodetach
# INTENSITY: fixed | gmatch
# DATASET: cifar10 | cifar100
# Do not retune alpha/tau. L=T=16.
#
# Unique trains (recommended):
#   l2wo/fixed and mne/fixed reuse five-regs ckpts (eval only).
#   mne/gmatch == mne/fixed and nodetach/gmatch == nodetach/fixed at init, skip those 4 cells.
#
#   cd /home/595/sl9144/codes/snn_simulation && git fetch origin && git reset --hard origin/main
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   for DS in cifar10 cifar100; do
#     for V in l2wo mne; do
#       qsub -N "v16mnec_${DS}_${V}_fixed" \
#         -v CIFAR_ROOT,DATASET=${DS},VARIANT=${V},INTENSITY=fixed,SEED=42,OUT_DIR=/scratch/gs14/sl9144/snn_results/cifar_vgg16_mne_component_ablation_seed42,CKPT_ROOT=/home/595/sl9144/codes/snn_simulation/QCFS_simulation \
#         QCFS_simulation/noise3_exp/pbs_cifar_vgg16_mne_component_ablation_seed42.pbs
#     done
#     qsub -N "v16mnec_${DS}_l2wo_gmatch" \
#       -v CIFAR_ROOT,DATASET=${DS},VARIANT=l2wo,INTENSITY=gmatch,SEED=42,OUT_DIR=/scratch/gs14/sl9144/snn_results/cifar_vgg16_mne_component_ablation_seed42,CKPT_ROOT=/home/595/sl9144/codes/snn_simulation/QCFS_simulation \
#       QCFS_simulation/noise3_exp/pbs_cifar_vgg16_mne_component_ablation_seed42.pbs
#     for V in effective nodetach; do
#       qsub -N "v16mnec_${DS}_${V}_fixed" \
#         -v CIFAR_ROOT,DATASET=${DS},VARIANT=${V},INTENSITY=fixed,SEED=42,OUT_DIR=/scratch/gs14/sl9144/snn_results/cifar_vgg16_mne_component_ablation_seed42,CKPT_ROOT=/home/595/sl9144/codes/snn_simulation/QCFS_simulation \
#         QCFS_simulation/noise3_exp/pbs_cifar_vgg16_mne_component_ablation_seed42.pbs
#     done
#     qsub -N "v16mnec_${DS}_effective_gmatch" \
#       -v CIFAR_ROOT,DATASET=${DS},VARIANT=effective,INTENSITY=gmatch,SEED=42,OUT_DIR=/scratch/gs14/sl9144/snn_results/cifar_vgg16_mne_component_ablation_seed42,CKPT_ROOT=/home/595/sl9144/codes/snn_simulation/QCFS_simulation \
#       QCFS_simulation/noise3_exp/pbs_cifar_vgg16_mne_component_ablation_seed42.pbs
#   done

set -euo pipefail

VARIANT="${VARIANT:?set VARIANT=l2wo|effective|mne|nodetach}"
INTENSITY="${INTENSITY:-fixed}"
DATASET="${DATASET:-cifar10}"
SEED="${SEED:-42}"

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/v16mnec_${DATASET}_${VARIANT}_${INTENSITY}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1
echo "LIVE_LOG=${LIVE_LOG}"
echo "DATASET=${DATASET} VARIANT=${VARIANT} INTENSITY=${INTENSITY} SEED=${SEED}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_vgg16_mne_component_ablation_seed42}"
CKPT_ROOT="${CKPT_ROOT:-/home/595/sl9144/codes/snn_simulation/QCFS_simulation}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "CKPT_ROOT=${CKPT_ROOT}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

ARGS=(
  --suite component
  --dataset "${DATASET}"
  --seed "${SEED}"
  --variant "${VARIANT}"
  --intensity "${INTENSITY}"
  --out-root "${OUT_DIR}"
  --ckpt-root "${CKPT_ROOT}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi

python -u noise3_exp/run_cifar_vgg16_mne_component_ablation_seed42.py "${ARGS[@]}"

echo "=== ALL DONE $(date) DATASET=${DATASET} VARIANT=${VARIANT} INTENSITY=${INTENSITY} SEED=${SEED} ==="
ls -la "${OUT_DIR}/${DATASET}/comp_${VARIANT}_${INTENSITY}" || ls -la "${OUT_DIR}"
