#!/bin/bash
#PBS -N vssd5r
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# VOC SSD300-VGG16-BN-IF seed-42 five-regularizer noise transfer.
# METHOD: mne | nodetach | l2wo | l2all | l1wo
# Train T=0, eval T=16, rate_uniform, post_input_if.
# Coefficients are the CIFAR defaults (do not retune):
#   mne/nodetach rc=1e-4; l2wo/l2all WD=5e-4; l1wo rc=1e-5
# Results/logs on scratch. Do not tee to $HOME.
#
# Login node, once:
#   cd /home/595/sl9144/codes/snn_simulation && git fetch origin && git reset --hard origin/main
#   export VOC_ROOT=/home/595/sl9144/datasets
#   module purge
#   module use /g/data/dk92/apps/Modules/modulefiles
#   module load NCI-ai-ml/24.11
#   python QCFS_simulation/noise3_exp/voc_ssd.py --download --voc-root "${VOC_ROOT}"
# If pjreddie 403s, the script now uses Oxford thor.robots first + wget User-Agent.
# Manual fallback:
#   mkdir -p "${VOC_ROOT}/_voc_tarballs" && cd "${VOC_ROOT}/_voc_tarballs"
#   UA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36'
#   wget -c --user-agent="$UA" https://thor.robots.ox.ac.uk/pascal/VOC/voc2007/VOCtrainval_06-Nov-2007.tar
#   wget -c --user-agent="$UA" https://thor.robots.ox.ac.uk/pascal/VOC/voc2007/VOCtest_06-Nov-2007.tar
#   wget -c --user-agent="$UA" https://thor.robots.ox.ac.uk/pascal/VOC/voc2012/VOCtrainval_11-May-2012.tar
#   cd "${VOC_ROOT}" && tar -xf _voc_tarballs/VOCtrainval_06-Nov-2007.tar \
#     && tar -xf _voc_tarballs/VOCtest_06-Nov-2007.tar \
#     && tar -xf _voc_tarballs/VOCtrainval_11-May-2012.tar
#
# Submit (5 jobs):
#   cd /home/595/sl9144/codes/snn_simulation
#   export VOC_ROOT=/home/595/sl9144/datasets
#   for M in mne nodetach l2wo l2all l1wo; do
#     qsub -N "vssd_${M}" \
#       -v VOC_ROOT,METHOD=${M},SEED=42,OUT_DIR=/scratch/gs14/sl9144/snn_results/voc_ssd300_five_regs_seed42 \
#       QCFS_simulation/noise3_exp/pbs_voc_ssd300_five_regs_seed42.pbs
#   done

set -euo pipefail

METHOD="${METHOD:?set METHOD=mne|nodetach|l2wo|l2all|l1wo}"
SEED="${SEED:-42}"

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/vssd_${METHOD}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1
echo "LIVE_LOG=${LIVE_LOG}"
echo "METHOD=${METHOD} SEED=${SEED} TEST_ONLY=${TEST_ONLY:-0}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export VOC_ROOT="${VOC_ROOT:-/home/595/sl9144/datasets}"
export VOC_BATCH="${VOC_BATCH:-16}"
export VOC_EVAL_BATCH="${VOC_EVAL_BATCH:-8}"
export VOC_NUM_WORKERS="${VOC_NUM_WORKERS:-8}"
export VOC_EPOCHS="${VOC_EPOCHS:-80}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export TORCH_HOME="${TORCH_HOME:-${HOME}/.cache/torch}"

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/voc_ssd300_five_regs_seed42}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "VOC_ROOT=${VOC_ROOT}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

if [[ ! -f "${VOC_ROOT}/VOC2007/ImageSets/Main/trainval.txt" \
   && ! -f "${VOC_ROOT}/VOCdevkit/VOC2007/ImageSets/Main/trainval.txt" ]]; then
  echo "ERROR: VOC 2007+2012 missing under VOC_ROOT=${VOC_ROOT}"
  echo "Download on a login node:"
  echo "  python ${ROOT}/noise3_exp/voc_ssd.py --download --voc-root ${VOC_ROOT}"
  exit 1
fi

ARGS=(
  --method "${METHOD}"
  --seed "${SEED}"
  --voc-root "${VOC_ROOT}"
  --out-root "${OUT_DIR}"
  --batch-size "${VOC_BATCH}"
  --eval-batch-size "${VOC_EVAL_BATCH}"
  --workers "${VOC_NUM_WORKERS}"
  --epochs "${VOC_EPOCHS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi

python -u noise3_exp/run_voc_ssd300_five_regs_seed42.py "${ARGS[@]}"

echo "=== ALL DONE $(date) METHOD=${METHOD} SEED=${SEED} ==="
ls -la "${OUT_DIR}/${METHOD}" || ls -la "${OUT_DIR}"
