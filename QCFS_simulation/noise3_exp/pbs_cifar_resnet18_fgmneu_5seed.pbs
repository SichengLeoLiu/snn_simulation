#!/bin/bash
#PBS -N r18fg5
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=36:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# ResNet-18 5-seed completion, residual-aware map.
# METHOD: body | fgmneu
#   body    no-detach MNE, no unmatched L2   (writes beside rmap seed 42)
#   fgmneu  no-detach MNE + unmatched L2     (writes beside FG-MNE-U seed 42)
# DATASET: cifar10 | cifar100
# SEED: 40 41 43 44   (seed 42 already trained; this PBS refuses 42)
#
# Locked: η_MNE=1e-4, η_U=5e-4, resnet map, T=L=16, EVAL_SEED=0.
# Do not retune from test. Do not overwrite seed-42 directories.
# Do not touch ImageNet jobs. Do not submit sequential-pairing (four-regs) again.
#
#   cd /home/595/sl9144/codes/snn_simulation
#   git fetch origin codex/task-cov-mne-resnet18
#   git checkout origin/codex/task-cov-mne-resnet18 -- \
#     QCFS_simulation/noise3_exp/run_cifar_mne_unmatched_head_l2_seed42.py \
#     QCFS_simulation/noise3_exp/pbs_cifar_resnet18_fgmneu_5seed.pbs
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   PBS=QCFS_simulation/noise3_exp/pbs_cifar_resnet18_fgmneu_5seed.pbs
#   OUT_BODY=/scratch/gs14/sl9144/snn_results/cifar_resnet18_nodetach_resnetmap_seed42
#   OUT_FG=/scratch/gs14/sl9144/snn_results/cifar_mne_nodetach_unmatched_head_l2_seed42
#   for DS in cifar10 cifar100; do
#     TAG=${DS#cifar}
#     for S in 40 41 43 44; do
#       qsub -l walltime=36:00:00 -N "rb${TAG}s${S}" \
#         -v CIFAR_ROOT,DATASET=${DS},METHOD=body,SEED=${S},EVAL_SEED=0,OUT_DIR=${OUT_BODY} \
#         ${PBS}
#       qsub -l walltime=36:00:00 -N "rh${TAG}s${S}" \
#         -v CIFAR_ROOT,DATASET=${DS},METHOD=fgmneu,SEED=${S},EVAL_SEED=0,OUT_DIR=${OUT_FG} \
#         ${PBS}
#     done
#   done

set -euo pipefail

ARCH="resnet18"
DATASET="${DATASET:?set DATASET=cifar10|cifar100}"
METHOD="${METHOD:?set METHOD=body|fgmneu}"
SEED="${SEED:?set SEED=40|41|43|44}"
EVAL_SEED="${EVAL_SEED:-0}"
N_STREAMS="${N_STREAMS:-8}"
DIAG_SIGMAS="${DIAG_SIGMAS:-1,3,5}"
BODY="nodetach"
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac
case "${METHOD}" in
  body)
    TRAIN_METHOD="mne_body"
    DEFAULT_OUT="/scratch/gs14/sl9144/snn_results/cifar_resnet18_nodetach_resnetmap_seed42"
    NOTE="regularizer=mne_l2 layer_map=resnet no unmatched L2"
    ;;
  fgmneu)
    TRAIN_METHOD="mne_head"
    DEFAULT_OUT="/scratch/gs14/sl9144/snn_results/cifar_mne_nodetach_unmatched_head_l2_seed42"
    NOTE="regularizer=mne_l2_unmatched layer_map=resnet unmatched L2 on fc"
    ;;
  *) echo "ERROR: invalid METHOD=${METHOD} (use body|fgmneu)"; exit 2 ;;
esac
case "${SEED}" in
  40|41|43|44) ;;
  42)
    echo "ERROR: seed 42 already trained; do not resubmit this PBS"
    exit 2
    ;;
  *) echo "ERROR: invalid SEED=${SEED} (use 40 41 43 44)"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/r18fg5_${DATASET}_${METHOD}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export N_STREAMS
export DIAG_SIGMAS

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-${DEFAULT_OUT}}"
mkdir -p "${OUT_DIR}"
echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) ARCH=${ARCH} DATASET=${DATASET} METHOD=${METHOD} TRAIN_METHOD=${TRAIN_METHOD} SEED=${SEED} EVAL_SEED=${EVAL_SEED}"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR} TEST_ONLY=${TEST_ONLY:-0} RETRAIN=${RETRAIN:-0}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"
echo "NOTE: ${NOTE}"

if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

SEED42=""
if [[ "${METHOD}" == "body" ]]; then
  SEED42="${OUT_DIR}/${DATASET}/resnet18_mne_body/seed42/scorecard.json"
else
  SEED42="${OUT_DIR}/${DATASET}/resnet18_mne_head/seed42/scorecard.json"
fi
if [[ ! -f "${SEED42}" ]]; then
  echo "WARN: seed-42 scorecard not found at ${SEED42}"
fi
TARGET="${OUT_DIR}/${DATASET}/resnet18_${TRAIN_METHOD}/seed${SEED}"
if [[ -e "${TARGET}/checkpoints" && "${RETRAIN:-0}" != "1" ]]; then
  echo "NOTE: target already exists, runner will skip train if ckpt is present: ${TARGET}"
fi

ARGS=(
  --arch "${ARCH}"
  --dataset "${DATASET}"
  --method "${TRAIN_METHOD}"
  --body "${BODY}"
  --seed "${SEED}"
  --eval-seed "${EVAL_SEED}"
  --n-streams "${N_STREAMS}"
  --sigmas "${DIAG_SIGMAS}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi
if [[ "${SKIP_DIAG:-0}" == "1" ]]; then
  ARGS+=(--skip-diag)
fi

python -u noise3_exp/run_cifar_mne_unmatched_head_l2_seed42.py "${ARGS[@]}"
echo "DONE $(date)"
