#!/bin/bash
#PBS -N lamarch
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=36:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR ∇λ-only + unmatched L2 on other sizes: vgg11, vgg13, vgg19, resnet34.
# Seed 42. Same locked η as VGG-16 / ResNet-18 λ-only. EVAL_SEED=0.
# Do not submit ARCH=vgg16 or resnet18. Do not retune. Do not touch ImageNet.
#
#   cd /home/595/sl9144/codes/snn_simulation
#   git fetch origin codex/task-cov-mne-resnet18
#   git checkout origin/codex/task-cov-mne-resnet18 -- \
#     QCFS_simulation/noise3_exp/run_cifar_fgmneu_lambda_arch_seed42.py \
#     QCFS_simulation/noise3_exp/pbs_cifar_fgmneu_lambda_arch_seed42.pbs
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   PBS=QCFS_simulation/noise3_exp/pbs_cifar_fgmneu_lambda_arch_seed42.pbs
#   OUT=/scratch/gs14/sl9144/snn_results/cifar_fgmneu_lambda_arch_seed42
#   for DS in cifar10 cifar100; do
#     TAG=${DS#cifar}
#     qsub -N "v11lam${TAG}" -l walltime=36:00:00 \
#       -v CIFAR_ROOT,DATASET=${DS},ARCH=vgg11,OUT_DIR=${OUT} ${PBS}
#     qsub -N "v13lam${TAG}" -l walltime=36:00:00 \
#       -v CIFAR_ROOT,DATASET=${DS},ARCH=vgg13,OUT_DIR=${OUT} ${PBS}
#     qsub -N "v19lam${TAG}" -l walltime=36:00:00 \
#       -v CIFAR_ROOT,DATASET=${DS},ARCH=vgg19,OUT_DIR=${OUT} ${PBS}
#     qsub -N "r34lam${TAG}" -l walltime=36:00:00 \
#       -v CIFAR_ROOT,DATASET=${DS},ARCH=resnet34,OUT_DIR=${OUT} ${PBS}
#   done

set -euo pipefail

DATASET="${DATASET:?set DATASET=cifar10|cifar100}"
ARCH="${ARCH:?set ARCH=vgg11|vgg13|vgg19|resnet34}"
SEED="${SEED:-42}"
EVAL_SEED="${EVAL_SEED:-0}"
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac
case "${ARCH}" in
  vgg11|vgg13|vgg19|resnet34) ;;
  vgg16|resnet18)
    echo "ERROR: ${ARCH} already has a lambda-only tree; do not resubmit here"
    exit 2
    ;;
  *) echo "ERROR: invalid ARCH=${ARCH}"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/lamarch_${ARCH}_${DATASET}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_fgmneu_lambda_arch_seed42}"
mkdir -p "${OUT_DIR}"
echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) ARCH=${ARCH} DATASET=${DATASET} SEED=${SEED} EVAL_SEED=${EVAL_SEED}"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"
echo "NOTE: size-sweep nabla-lambda-only + unmatched L2; gamma detached; do not retune; do not touch ImageNet"

if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

ARGS=(
  --arch "${ARCH}"
  --dataset "${DATASET}"
  --seed "${SEED}"
  --eval-seed "${EVAL_SEED}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi

python -u noise3_exp/run_cifar_fgmneu_lambda_arch_seed42.py "${ARGS[@]}"
echo "DONE $(date) ARCH=${ARCH} DATASET=${DATASET} SEED=${SEED}"
ls -la "${OUT_DIR}/${DATASET}/${ARCH}_fgmneu_lambda/seed${SEED}" || true
