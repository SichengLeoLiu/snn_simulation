#!/bin/bash
#PBS -N v16lt
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=08:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# Fill missing VGG-16 CIFAR-10 noise cells. Eval only.
# QUANT_L=4|8|16|32
#   L=4/8/32 seed 42, T != L
#   L=16 seeds 40-44, T=32 only
#
#   PBS=QCFS_simulation/noise3_exp/pbs_cifar_vgg16_lt_grid_cifar10.pbs
#   OUT=/scratch/gs14/sl9144/snn_results/cifar_vgg16_lt_grid_cifar10
#   for L in 4 8 16 32; do
#     qsub -N "v16lt_L${L}" -l walltime=08:00:00 \
#       -v CIFAR_ROOT,QUANT_L=${L},OUT_DIR=${OUT} "$PBS"
#   done

set -euo pipefail

QUANT_L="${QUANT_L:?set QUANT_L=4|8|16|32}"
case "${QUANT_L}" in
  4|8|16|32) ;;
  *) echo "ERROR: invalid QUANT_L=${QUANT_L}"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/v16lt_L${QUANT_L}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_vgg16_lt_grid_cifar10}"
mkdir -p "${OUT_DIR}"
echo "host=$(hostname) date=$(date) QUANT_L=${QUANT_L} OUT_DIR=${OUT_DIR}"

python3 -u noise3_exp/run_cifar_vgg16_lt_grid_cifar10.py \
  --quant-L "${QUANT_L}" \
  --out-root "${OUT_DIR}" \
  --batch-size "${CIFAR_BATCH}" \
  --workers "${CIFAR_NUM_WORKERS}"

echo "DONE $(date) QUANT_L=${QUANT_L}"
