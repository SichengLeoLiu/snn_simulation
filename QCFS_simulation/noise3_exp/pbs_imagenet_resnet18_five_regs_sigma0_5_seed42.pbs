#!/bin/bash
#PBS -N img5reg
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=48:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# ImageNet ResNet-18 seed42 五方法之一：训练（若缺 ckpt）+ post-IF σ=0…5
# 必须通过 -v METHOD=... 指定一种方法，五种分开提交以便并行。
#   METHOD=weight_decay
#   METHOD=weight_decay_weights_only
#   METHOD=l1
#   METHOD=old_detach
#   METHOD=calibrated_mne_a0p1
#
# Login:
#   cd /home/595/sl9144/codes/snn_simulation && git pull
#   source QCFS_simulation/scripts/setup_gadi_imagenet.sh
#   for m in weight_decay weight_decay_weights_only l1 old_detach calibrated_mne_a0p1; do
#     qsub -v METHOD=$m QCFS_simulation/noise3_exp/pbs_imagenet_resnet18_five_regs_sigma0_5_seed42.pbs
#   done

set -euo pipefail

METHOD="${METHOD:?set METHOD, e.g. qsub -v METHOD=old_detach ...}"

mkdir -p /home/595/sl9144/logs
LIVE_LOG="/home/595/sl9144/logs/img5reg_${METHOD}.${PBS_JOBID:-manual}.out"
exec > >(tee -a "${LIVE_LOG}") 2>&1
echo "LIVE_LOG=${LIVE_LOG}"
echo "METHOD=${METHOD}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

source /home/595/sl9144/codes/snn_simulation/QCFS_simulation/scripts/setup_gadi_imagenet.sh
export IMAGENET_OFFLINE=1
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export IMAGENET_EPOCHS="${IMAGENET_EPOCHS:-90}"
export IMAGENET_BATCH="${IMAGENET_BATCH:-128}"
export IMAGENET_NUM_WORKERS="${IMAGENET_NUM_WORKERS:-8}"

ROOT=/home/595/sl9144/codes/snn_simulation/QCFS_simulation
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-${ROOT}/../important_results/imagenet_resnet18_five_regs_sigma0_5_seed42}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "HF_HOME=${HF_HOME:-}"
echo "IMAGENET_OFFLINE=${IMAGENET_OFFLINE}"

python - <<'PY'
import torch
print("torch", torch.__version__, "cuda", torch.cuda.is_available())
if torch.cuda.is_available():
    print("device", torch.cuda.get_device_name(0))
PY

python -u noise3_exp/run_imagenet_resnet18_five_regs_noise_sweep.py \
  --method "${METHOD}" \
  --epochs "${IMAGENET_EPOCHS}" \
  --batch-size "${IMAGENET_BATCH}" \
  --workers "${IMAGENET_NUM_WORKERS}" \
  --first-layer-noise-position post_input_if \
  --noise-sigma-start 0.0 \
  --noise-sigma-end 5.0 \
  --noise-sigma-step 0.25 \
  --out-root "${OUT_DIR}"

echo "=== ALL DONE $(date) METHOD=${METHOD} ==="
ls -la "${OUT_DIR}/${METHOD}" || true
