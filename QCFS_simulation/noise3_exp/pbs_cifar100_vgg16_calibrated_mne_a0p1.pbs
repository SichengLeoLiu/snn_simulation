#!/bin/bash
#PBS -N c100_cmne
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR-100 VGG16 seed42：L2-wo 基线 + Calibrated MNE α=0.1
#
#   R = 0.5 * sum_l q_l ||W_l||_F^2
#   q = (1-α) + α * normalize(L^2/λ^2 * γ^2/var)   （λ/γ/var 全部 detach）
#   α=0.1，reg_coeff=5e-4（α=0 时与 weights-only WD 对齐）
#   epoch 0-29: α=0；30-79: 线性升到 0.1；之后保持 0.1
#
# Login 节点提交：
#   mkdir -p ~/logs
#   cd /home/595/sl9144/codes/snn_simulation && git pull
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   qsub -v CIFAR_ROOT QCFS_simulation/noise3_exp/pbs_cifar100_vgg16_calibrated_mne_a0p1.pbs
#   qstat -u $USER

set -euo pipefail

mkdir -p /home/595/sl9144/logs
LIVE_LOG="/home/595/sl9144/logs/c100_cmne.${PBS_JOBID:-manual}.out"
exec > >(tee -a "${LIVE_LOG}") 2>&1
echo "LIVE_LOG=${LIVE_LOG}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export CIFAR_EPOCHS="${CIFAR_EPOCHS:-300}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-${ROOT}/../important_results/cifar100_vgg16_calibrated_mne_a0p1_seed42}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "CIFAR_ROOT=${CIFAR_ROOT}"
if [[ ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  echo "Expected: ${CIFAR_ROOT}/cifar-100-python/meta"
  exit 1
fi

python - <<'PY'
import torch
print("torch", torch.__version__, "cuda", torch.cuda.is_available())
if torch.cuda.is_available():
    print("device", torch.cuda.get_device_name(0))
else:
    print("WARNING: CUDA not available")
PY

python -u noise3_exp/run_mne_stability_ablation.py \
  --datasets cifar100 \
  --variants calibrated_mne_a0p1 \
  --baselines weight_decay_weights_only \
  --seeds 42 \
  --epochs "${CIFAR_EPOCHS}" \
  --batch-size "${CIFAR_BATCH}" \
  --workers "${CIFAR_NUM_WORKERS}" \
  --first-layer-noise-position post_input_if \
  --out-root "${OUT_DIR}"

echo "=== ALL DONE $(date) ==="
ls -la "${OUT_DIR}"/mne_stability_ablation_*.csv
