#!/bin/bash
#PBS -N v16l2l
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# CIFAR VGG-16 L2-wo / L2-all at L=T in {4,8,32}.
# VARIANT: l2wo | l2all
# QUANT_L: 4 | 8 | 16 | 32
# DATASET: cifar10 | cifar100 | both
#   both -> C10 on GPU0, C100 on GPU1 (qsub -l ncpus=24,ngpus=2,mem=160GB)
# Optimizer WD=5e-4, no per-L retune. Train T=0, eval T=QUANT_L.
# Multi-seed: set OUT_DIR per seed (cfg_dir has no seed folder).

set -euo pipefail

VARIANT="${VARIANT:?set VARIANT=l2wo|l2all}"
QUANT_L="${QUANT_L:?set QUANT_L=4|8|16|32}"
DATASET="${DATASET:-both}"
SEED="${SEED:-42}"

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/v16l2l_${DATASET}_${VARIANT}_L${QUANT_L}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1
echo "LIVE_LOG=${LIVE_LOG}"
echo "DATASET=${DATASET} VARIANT=${VARIANT} QUANT_L=${QUANT_L} SEED=${SEED}"

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_vgg16_l2_lscale_seed42}"
CKPT_ROOT="${CKPT_ROOT:-/home/595/sl9144/codes/snn_simulation/QCFS_simulation}"
mkdir -p "${OUT_DIR}"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "CKPT_ROOT=${CKPT_ROOT}"
echo "ngpus=${PBS_NGPUS:-?} ncpus=${PBS_NCPUS:-?}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

if [[ ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

run_one() {
  local ds="$1"
  local gpu="$2"
  local log="${SCRATCH_LOG}/v16l2l_${ds}_${VARIANT}_L${QUANT_L}_seed${SEED}.${PBS_JOBID:-manual}.gpu${gpu}.out"
  local args=(
    --suite l2l
    --dataset "${ds}"
    --seed "${SEED}"
    --variant "${VARIANT}"
    --quant-L "${QUANT_L}"
    --out-root "${OUT_DIR}"
    --ckpt-root "${CKPT_ROOT}"
    --batch-size "${CIFAR_BATCH}"
    --workers "${CIFAR_NUM_WORKERS}"
  )
  if [[ "${TEST_ONLY:-0}" == "1" ]]; then
    args+=(--test-only)
  fi
  if [[ "${RETRAIN:-0}" == "1" ]]; then
    args+=(--retrain)
  fi
  echo "[LAUNCH] ds=${ds} gpu=${gpu} log=${log}"
  CUDA_VISIBLE_DEVICES="${gpu}" python -u noise3_exp/run_cifar_vgg16_mne_component_ablation_seed42.py "${args[@]}" \
    >"${log}" 2>&1
  echo "[DONE] ds=${ds} gpu=${gpu}"
}

case "${DATASET}" in
  both)
    if [[ "${PBS_NGPUS:-1}" -lt 2 ]]; then
      echo "ERROR: DATASET=both needs ngpus>=2 (qsub -l ncpus=24,ngpus=2,mem=160GB)"
      exit 2
    fi
    run_one cifar10 0 &
    pid10=$!
    run_one cifar100 1 &
    pid100=$!
    status=0
    wait "${pid10}" || status=1
    wait "${pid100}" || status=1
    if [[ "${status}" -ne 0 ]]; then
      echo "ERROR: one or both dataset workers failed"
      exit 1
    fi
    ;;
  cifar10|cifar100)
    run_one "${DATASET}" 0
    ;;
  *)
    echo "ERROR: invalid DATASET=${DATASET}"
    exit 2
    ;;
esac

echo "=== ALL DONE $(date) DATASET=${DATASET} VARIANT=${VARIANT} L=${QUANT_L} SEED=${SEED} ==="
ls -la "${OUT_DIR}/cifar10" "${OUT_DIR}/cifar100" 2>/dev/null || true
