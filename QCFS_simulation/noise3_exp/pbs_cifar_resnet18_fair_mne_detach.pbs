#!/bin/bash
#PBS -N r18fairmne
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# P0: fair ResNet-18 MNE-L2 detach. Do not reuse historical MNE checkpoints.
# DATASET: cifar10 | cifar100
# REG_COEFF: 1e-4 | 3e-4 | 5e-4 | 1e-3  (locked follow-up uses 1e-4)
# SEED: 40–44. Canonical test noise: EVAL_SEED=0.
# Extra streams: EXTRA_EVAL=1 (seeds 1:2:3:4) writes eval_seed{N}/ and skips
# an existing canonical scorecard. Do not RETRAIN seed 42. PBS -v cannot use
# commas inside EXTRA_EVAL_SEEDS; use 1:2:3:4 or EXTRA_EVAL=1.
#
# Locked 5-seed train (skip seed 42 — already finished):
#   export CIFAR_ROOT=/home/595/sl9144/datasets
#   for DS in cifar10 cifar100; do
#     for S in 40 41 43 44; do
#       qsub -N "m${DS#cifar}s${S}" \
#         -v CIFAR_ROOT,DATASET=${DS},REG_COEFF=1e-4,SEED=${S},EVAL_SEED=0,OUT_DIR=/scratch/gs14/sl9144/snn_results/cifar_resnet18_fair_mne_detach \
#         QCFS_simulation/noise3_exp/pbs_cifar_resnet18_fair_mne_detach.pbs
#     done
#   done
#
# Extra eval-noise re-eval (TEST_ONLY, after checkpoints exist):
#   qsub -N "em10s42" -v CIFAR_ROOT,DATASET=cifar10,REG_COEFF=1e-4,SEED=42,EVAL_SEED=0,TEST_ONLY=1,EXTRA_EVAL=1,OUT_DIR=/scratch/gs14/sl9144/snn_results/cifar_resnet18_fair_mne_detach \
#     QCFS_simulation/noise3_exp/pbs_cifar_resnet18_fair_mne_detach.pbs

set -euo pipefail

DATASET="${DATASET:?set DATASET=cifar10|cifar100}"
REG_COEFF="${REG_COEFF:?set REG_COEFF=1e-4|3e-4|5e-4|1e-3}"
SEED="${SEED:-42}"
EVAL_SEED="${EVAL_SEED:-0}"
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac
case "${REG_COEFF}" in
  1e-4|3e-4|5e-4|1e-3) ;;
  *) echo "ERROR: invalid REG_COEFF=${REG_COEFF}"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/r18fairmne_${DATASET}_rc${REG_COEFF}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_resnet18_fair_mne_detach}"
mkdir -p "${OUT_DIR}"
echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) DATASET=${DATASET} REG_COEFF=${REG_COEFF} SEED=${SEED} EVAL_SEED=${EVAL_SEED} EXTRA_EVAL_SEEDS=${EXTRA_EVAL_SEEDS:-} TEST_ONLY=${TEST_ONLY:-0}"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"

if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

ARGS=(
  --dataset "${DATASET}"
  --reg-coeff "${REG_COEFF}"
  --seed "${SEED}"
  --eval-seed "${EVAL_SEED}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ "${TEST_ONLY:-0}" == "1" ]]; then
  ARGS+=(--test-only)
fi
if [[ "${RETRAIN:-0}" == "1" ]]; then
  ARGS+=(--retrain)
fi
if [[ "${EXTRA_EVAL:-0}" == "1" && -z "${EXTRA_EVAL_SEEDS:-}" ]]; then
  EXTRA_EVAL_SEEDS="1:2:3:4"
fi
if [[ -n "${EXTRA_EVAL_SEEDS:-}" ]]; then
  ARGS+=(--extra-eval-seeds "${EXTRA_EVAL_SEEDS}")
fi

python -u noise3_exp/run_cifar_resnet18_fair_mne_detach.py "${ARGS[@]}"
echo "DONE $(date)"
