#!/bin/bash
#PBS -N gradprobe_l2mne
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=48:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe
#PBS -o /home/595/sl9144/logs/grad_probe_l2all_mneall.out

# CIFAR-10 VGG16：显式 L2-all + MNE-all，训练中 early/mid/late 分解 CE vs reg 对 λ / BN-γ 的梯度
#
# Login 节点提交：
#   mkdir -p ~/logs
#   cd /home/595/sl9144/codes/snn_simulation && git pull
#   qsub QCFS_simulation/noise3_exp/pbs_cifar10_vgg16_grad_probe_l2all_mneall.pbs
#   qstat -u $USER
#
# 看日志：
#   tail -f ~/logs/grad_probe_l2all_mneall.out

set -euo pipefail

mkdir -p /home/595/sl9144/logs

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/scratch/gs14/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
# 若在 repo 根目录 qsub，PBS_O_WORKDIR 可能是 snn_simulation 或 QCFS_simulation
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-${ROOT}/../important_results/cifar10_vgg16_grad_probe_l2all_mneall_seed42}"
mkdir -p "${OUT_DIR}/manual_l2_all" "${OUT_DIR}/mne_l2_all"

echo "=== host=$(hostname) date=$(date) ==="
echo "ROOT=${ROOT}"
echo "OUT_DIR=${OUT_DIR}"
echo "CIFAR_ROOT=${CIFAR_ROOT}"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-}"
# Use heredoc: PBS/shell quoting often breaks python -c one-liners.
python - <<'PY'
import torch
print("torch", torch.__version__, "cuda", torch.cuda.is_available())
if torch.cuda.is_available():
    print("device", torch.cuda.get_device_name(0))
else:
    print("WARNING: CUDA not available")
PY

# ---------- 1) L2-all：显式 sum(p^2)，rc=2.5e-4 ≈ SGD wd=5e-4 ----------
echo "=== START manual_l2_all $(date) ==="
python -u main_train.py \
  -data cifar10 \
  -arch vgg16 \
  -T 0 \
  -L 16 \
  --epochs 300 \
  -lr 0.1 \
  -b "${CIFAR_BATCH}" \
  -j "${CIFAR_NUM_WORKERS}" \
  --seed 42 \
  --regularizer manual_l2_all \
  --reg_coeff 2.5e-4 \
  --weight_decay 0 \
  -suffix gradprobe_L2all_seed42_L16 \
  --ckpt-save-mode last \
  --grad_probe \
  --grad_probe_epochs auto \
  --grad_probe_csv "${OUT_DIR}/manual_l2_all/seed42_grad_probe.csv"
echo "=== DONE manual_l2_all $(date) ==="

# ---------- 2) MNE-all：MNE on matched weights + L2 on remaining ----------
echo "=== START mne_l2_all $(date) ==="
python -u main_train.py \
  -data cifar10 \
  -arch vgg16 \
  -T 0 \
  -L 16 \
  --epochs 300 \
  -lr 0.1 \
  -b "${CIFAR_BATCH}" \
  -j "${CIFAR_NUM_WORKERS}" \
  --seed 42 \
  --regularizer mne_l2_all \
  --reg_coeff 1e-4 \
  --weight_decay 0 \
  --mne_detach_lambda \
  -suffix gradprobe_MNEall_seed42_L16 \
  --ckpt-save-mode last \
  --grad_probe \
  --grad_probe_epochs auto \
  --grad_probe_csv "${OUT_DIR}/mne_l2_all/seed42_grad_probe.csv"
echo "=== DONE mne_l2_all $(date) ==="

echo "=== ALL DONE $(date) ==="
echo "Probes:"
ls -la "${OUT_DIR}/manual_l2_all/seed42_grad_probe.csv" "${OUT_DIR}/mne_l2_all/seed42_grad_probe.csv"
