#!/bin/bash
#PBS -N v16efh
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=36:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# VGG-16 seed-42 Effective L2 + unmatched-head L2.
# DATASET: cifar10 | cifar100
# Body = BN-folded M_eff (no 1/λ^2, no L^2, detach λ/γ).
# Fallback = ordinary L2 on unmatched Conv/Linear, η_U=5e-4.
# Completes the five-row same-map component table. Do not retune from test.
#
# Combined submit is in the chat; this PBS is the two new V100 jobs.

set -euo pipefail

DATASET="${DATASET:?set DATASET=cifar10|cifar100}"
SEED="${SEED:-42}"
EVAL_SEED="${EVAL_SEED:-0}"
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/v16efh_${DATASET}_seed${SEED}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_vgg16_effective_l2_head_seed42}"
mkdir -p "${OUT_DIR}"
echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) DATASET=${DATASET} SEED=${SEED}"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"
echo "NOTE: Effective L2 body + unmatched-head L2; not the old IF-matched-only effective cell"

python -u noise3_exp/run_cifar_vgg16_effective_l2_head_seed42.py \
  --dataset "${DATASET}" \
  --seed "${SEED}" \
  --eval-seed "${EVAL_SEED}" \
  --out-root "${OUT_DIR}" \
  --batch-size "${CIFAR_BATCH}" \
  --workers "${CIFAR_NUM_WORKERS}"

echo "DONE $(date)"
