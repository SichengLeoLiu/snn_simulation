#!/bin/bash
#PBS -N t48pan
#PBS -P gs14
#PBS -q gpuvolta
#PBS -l walltime=16:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=80GB
#PBS -l storage=gdata/dk92+scratch/gs14+gdata/gs14
#PBS -l wd
#PBS -j oe

# L=16 conversion eval at T=4 and T=8. One GPU = one (DATASET, ARCH) panel.
# Loops L2-all / L2-wo / L1-wo / lambda and seeds 40-44. Eval-only.
# New tree only. Do not overwrite T=0 / T=16 / lambda training / ImageNet.
#
#   PBS=QCFS_simulation/noise3_exp/pbs_cifar_l16_t48_evalseed0.pbs
#   OUT=/scratch/gs14/sl9144/snn_results/cifar_l16_t48_evalseed0

set -euo pipefail

DATASET="${DATASET:?set DATASET=cifar10|cifar100}"
ARCH="${ARCH:?set ARCH=vgg16|resnet18}"
EVAL_SEED="${EVAL_SEED:-0}"
SEEDS="${SEEDS:-40 41 42 43 44}"
case "${DATASET}" in
  cifar10|cifar100) ;;
  *) echo "ERROR: invalid DATASET=${DATASET}"; exit 2 ;;
esac
case "${ARCH}" in
  vgg16|resnet18) ;;
  *) echo "ERROR: invalid ARCH=${ARCH}"; exit 2 ;;
esac

SCRATCH_LOG="${SCRATCH_LOG:-/scratch/gs14/sl9144/logs}"
mkdir -p "${SCRATCH_LOG}"
LIVE_LOG="${SCRATCH_LOG}/t48_${ARCH}_${DATASET}.${PBS_JOBID:-manual}.out"
exec > "${LIVE_LOG}" 2>&1

module purge
module use /g/data/dk92/apps/Modules/modulefiles
module load NCI-ai-ml/24.11

export CIFAR_ROOT="${CIFAR_ROOT:-/home/595/sl9144/datasets}"
export CIFAR_BATCH="${CIFAR_BATCH:-128}"
export CIFAR_NUM_WORKERS="${CIFAR_NUM_WORKERS:-8}"
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

REPO="${PBS_O_WORKDIR:-/home/595/sl9144/codes/snn_simulation}"
if [[ -d "${REPO}/QCFS_simulation" ]]; then
  ROOT="${REPO}/QCFS_simulation"
elif [[ -f "${REPO}/main_train.py" ]]; then
  ROOT="${REPO}"
else
  ROOT="/home/595/sl9144/codes/snn_simulation/QCFS_simulation"
fi
cd "${ROOT}"

OUT_DIR="${OUT_DIR:-/scratch/gs14/sl9144/snn_results/cifar_l16_t48_evalseed0}"
mkdir -p "${OUT_DIR}"
echo "LIVE_LOG=${LIVE_LOG}"
echo "host=$(hostname) date=$(date) ARCH=${ARCH} DATASET=${DATASET} T=4,8 L=16"
echo "ROOT=${ROOT} OUT_DIR=${OUT_DIR} EVAL_SEED=${EVAL_SEED}"
echo "git=$(git -C "${ROOT}/.." rev-parse --short HEAD 2>/dev/null || true)"
echo "NOTE: L=16 T=4/8 eval-only; reuse ckpts; do not train"

if [[ "${DATASET}" == "cifar10" && ! -f "${CIFAR_ROOT}/cifar-10-batches-py/batches.meta" ]]; then
  echo "ERROR: CIFAR-10 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi
if [[ "${DATASET}" == "cifar100" && ! -f "${CIFAR_ROOT}/cifar-100-python/meta" ]]; then
  echo "ERROR: CIFAR-100 missing under CIFAR_ROOT=${CIFAR_ROOT}"
  exit 1
fi

# shellcheck disable=SC2206
SEED_ARR=(${SEEDS})
ARGS=(
  --arch "${ARCH}"
  --dataset "${DATASET}"
  --times 4 8
  --eval-seed "${EVAL_SEED}"
  --seeds "${SEED_ARR[@]}"
  --out-root "${OUT_DIR}"
  --batch-size "${CIFAR_BATCH}"
  --workers "${CIFAR_NUM_WORKERS}"
)
if [[ -n "${METHOD:-}" ]]; then
  ARGS+=(--method "${METHOD}")
fi
if [[ "${FORCE:-0}" == "1" ]]; then
  ARGS+=(--force)
fi
if [[ "${DRY_RESOLVE:-0}" == "1" ]]; then
  ARGS+=(--dry-resolve)
fi

python3 -u noise3_exp/run_cifar_l16_t48_evalseed0.py "${ARGS[@]}"
echo "DONE $(date) ARCH=${ARCH} DATASET=${DATASET}"
ls -la "${OUT_DIR}/${DATASET}" || true

